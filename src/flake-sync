#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# flake-sync: assess and converge the workspace's flake repos in DAG order.
#
# The workspace is found from the caller's cwd: the enclosing git repo,
# walked up to the parent-most repo that tracks it as a submodule (a repo
# that is not a submodule of another repo is a workspace by itself; a cwd outside any
# git repo is an error).
#
# The workspace is a git repo with flake submodules that pin each other via
# github: inputs in their flake.locks. Convergence means: every repo's local
# pins point at the current HEAD of the corresponding sibling repo, every
# repo is pushed, and the workspace's submodule pointers match submodule
# HEADs. Repos are discovered from .gitmodules; cross-repo pins are detected
# by matching flake.lock github inputs against submodule remote URLs, so
# nothing is hardcoded.
#
# Pins are advanced with `nix flake lock --override-input <name>
# github:<owner>/<repo>/<rev>` using the sibling's exact local HEAD, which
# sidesteps GitHub tarball TTL caching and non-default branches. A pin can
# therefore only be advanced once its target rev has been pushed, which is
# what forces the DAG ordering.
#
# Before any lock is written, the proposed pin state is validated with
# `nix flake check --no-write-lock-file --override-input ...` (--check=
# none|eval|full; eval, evaluation-only, is the default). The full stale
# set is tried first (one check, and the only trial that can pass pins
# that must move jointly, e.g. siblings sharing a ch-flake rev); if it
# fails, stale targets are tried cumulatively in dependency order, and a
# failing or unpushed target holds back only the pins onto it: whatever passes
# advances in one commit and the held-back remainder is reported. The
# objective is to minimize the number of stale pins, never to bisect a
# target's history for a partially-newer safe rev. The standalone `check`
# command runs the same gate against every repo's *current* locks, with no
# overrides and nothing written: a read-only sweep of the whole system.
#
# With --with-external, root-level inputs that aren't siblings (nixpkgs,
# home-manager, etc.) are managed too: one is stale if `nix flake update
# <name>` would move its locked rev. The trial lock answering that also
# resolves the rev such an update lands on, and advancing re-locks with a
# fixed `--override-input` to exactly that rev, the same mechanism as
# sibling pins (there is no sibling HEAD, so the trial-resolved rev stands
# in), so the state the check gate validated is the state that gets
# locked. External pins have no DAG position and no unpushed-target
# concept; they join whatever sibling pins pass the same check gate in the
# same update-pins commit.

set -euo pipefail

build_id() { # "flake-sync <store hash> (<store path>)" for a store build, else the script's path
  local self store
  self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")
  case $self in
    /nix/store/*)
      store=${self#/nix/store/}
      store=${store%%/*}
      echo "flake-sync ${store%%-*} (/nix/store/$store)"
      ;;
    *) echo "flake-sync, not a Nix store build ($self)" ;;
  esac
}

usage() {
  build_id
  cat <<'EOF'
Usage: flake-sync <command> [options]

Commands:
  status      Show the git and pin state of the repos, plus pending actions
  next        Print the next action that would run, without running it
  step        Run the next ready action (or a specific one, see below)
  converge    Run ready actions until converged or blocked (with --local:
              working trees only: advance locks, commit and push nothing)
  pull        Down-sync from the remotes: fetch, fast-forward the workspace
              to its upstream, clone registered submodules that are not
              cloned (unregistered ones stay out), then re-attach each
              checked-out submodule to its default branch fast-forwarded to the recorded
              pointer, leaving no detached HEADs behind. A submodule that is
              dirty, diverged, or parked on a topic branch is held (and
              reported) rather than touched; exit 1 if anything held.
              With --heads: to origin's tip of the default branch instead
              of the recorded pointer, the state convergence starts from
  check       Run `nix flake check` on each repo (or one: `check <repo>`)
              against its current locks, read-only: nothing is re-pinned,
              committed, or pushed. Depth follows --check (eval by default,
              full builds the checks); --with-partitions also checks
              partition/dev input flakes
  graph       Print the dependency DAG in topological order
  unmerged-commits [--json]
              List, in DAG order, the checked-out repos whose branch has
              commits besides pin updates that are not on the remote
              default branch: the branch, whether it is pushed, the
              commits, the listed repos it depends on, its pull request
              (GitHub remotes), and its state. "dependencies not ready":
              a repo it depends on is listed. "waiting for convergence":
              its default branch pins a workspace dependency at a commit
              other than that dependency's remote default head. "ready":
              neither; its pull request can leave draft. --json prints
              the same as a JSON array
  pr <repo> --title=<title> --body-file=<file>
              Push <repo>'s topic branch and open or update its pull
              request (GitHub remotes), assigned to the gh user. It is a
              draft, its body led by a "status:" line saying why, until
              unmerged-commits calls the repo ready and the branch sits
              on the remote default branch; then it is opened, or taken
              out of draft. A merged pull request is refused
  rebase <repo>
              Rebase <repo>'s topic branch onto its remote default
              branch. A flake.lock conflict takes the default branch's
              lock, whose pins are converged, then nix flake lock adds
              the inputs the branch adds; a conflict in any other file
              stops for resolution by hand
  checkout <repo>... | --all
              Clone the named submodules that are not checked out here,
              or with --all all of them, and attach each to its default
              branch at the recorded pointer (with --heads: at origin's
              tip). The other commands read a submodule that is not
              checked out from its remote: pins onto it are managed, and
              converge bumps its pointer, but advancing the stale pins in
              its locks needs a checkout (see --checkout-missing).
              In a linked worktree of the workspace, the checkout is a
              linked worktree of the repo the workspace's common git dir
              keeps for the submodule, on a branch named after the
              workspace worktree's branch, from origin's tip
  override-inputs <flake-ref>
              Print <flake-ref>, then an `--override-input` flag for each
              input in its lock, at any depth, that pins a workspace repo
              at a commit other than the head of that repo's remote,
              moving it to that head. External inputs are left out. It
              reads .gitmodules, the flake and the remotes and changes
              nothing. Its output takes the place of a flake reference:
              `nixos-rebuild switch --flake $(flake-sync override-inputs .)`,
              `nix build $(flake-sync override-inputs '.#pkg')`.
              With --local, an input whose repo is an initialized
              submodule of this checkout moves to that submodule's HEAD
              instead, unpushed commits included; uncommitted changes are
              left out, with a warning

Step forms:
  step                          run the next ready action; if it fails, try
                                the remaining ready actions until one succeeds
  step <repo>                   likewise, restricted to <repo>
  step update-pins <repo>       re-pin <repo>'s stale local inputs and commit
  step push <repo>              push <repo>
  step bump-submodules          stage+commit stale submodule pointers (workspace)

Options:
  -n, --dry-run         Print state-changing commands instead of running them
      --check=MODE      How to validate proposed pin states before locks are
                        written, via `nix flake check --no-write-lock-file
                        --override-input ...`: none (skip validation), eval
                        (the default; adds --no-build, catching evaluation
                        errors only), or full (also builds the flake's
                        checks). The full stale set is tried first; if it
                        fails, targets are tried cumulatively in dependency
                        order, a failing target holds back only the pins onto it
                        while the remaining targets are still tried, and
                        whatever passes advances in one commit. The same
                        mode picks the depth of the `check` command (none
                        is rejected there)
      --fetch           Fetch the repos before assessing state, 8 at a time:
                        its default branch and its checked-out branch's
                        upstream, or all refs when HEAD is then on no
                        remote-tracking ref
      --heads           (pull, checkout) Sync each submodule to origin/<default>
                        rather than to the pointer the workspace records.
                        The pointers lag the remotes until convergence
                        runs; this reaches the remotes' state directly, so
                        `converge --local` can run from it. It is the step
                        a convergence runner takes before converging
      --local           Touch working trees only: advance pins through the
                        same check gate, but do not commit, push, or bump
                        submodule pointers. Runs with dirty trees and on
                        detached HEADs (with no commits, nothing can
                        strand), so it works in any checkout, including
                        agent worktrees. Pins still advance only to pushed
                        sibling revs, so the locks written are exactly the
                        ones CI convergence will commit
      --trust-local-checks
                        (converge, step push) Outside CI, pin commits reach a
                        GitHub default branch through a pull request that
                        is merged at once; when branch protection makes the
                        merge wait for required checks, auto-merge is
                        turned on and the run stops. With this flag the
                        merge does not wait: nix flake check runs here at
                        the --check depth, then the pull request merges
                        with gh's --admin override. FLAKE_SYNC_GH names
                        the gh executable (default gh)
      --checkout-missing
                        (converge, step) Clone a submodule that is not
                        checked out here when it has a stale pin that can
                        advance now, then advance it. Without it, such a
                        submodule blocks convergence and converge exits 1;
                        one whose stale pins wait on unpushed targets is
                        not cloned
      --with-partitions Also manage partition/dev input flakes: the tracked
                        flake.lock below a repo's root (e.g. tests/dependencies)
                        joins staleness detection and update-pins
      --with-tests      Also check always-unlocked test flakes (flake.nix with a
                        gitignored lock): report stray untracked flake.lock
                        files, which silently pin standalone runs to stale revs.
                        Informational only; their inputs are wired in nix code
                        from the partition inputs, so --with-partitions already
                        keeps them current
      --with-external   Also manage external (non-sibling) root-level inputs,
                        e.g. nixpkgs or home-manager: an input is stale if
                        `nix flake update <input>` would move its locked rev.
                        Ready external pins advance with the same check gate
                        and join the same update-pins commit as sibling pins
      --all             Shorthand for --with-partitions --with-tests --with-external
      --latest-flake-sync
                        Run the head of the flake that publishes flake-sync
                        instead of this copy of flake-sync, through `nix run
                        --refresh`, with the same arguments; it does not
                        change what the command operates on
                        (FLAKE_SYNC_UPSTREAM, default
                        github:clhodapp/flake-sync, names the flake)
      --version         Print the store hash and path of this build (the
                        first line of this help)
  -h, --help            Show this help

The workspace is found from the current directory: the enclosing git repo,
walked up to the parent-most repo that tracks it as a submodule. A repo
that is not a submodule of another repo is a workspace by itself; a cwd outside any git
repo is an error.

Actions only run when safe: pins advance only to pushed revs (and, by
default, only if the proposed pin state passes an evaluation-only nix flake
check), and a pin that cannot advance holds back only itself, not its
siblings. Pushes are skipped on detached HEADs or when behind upstream, and
repos with uncommitted changes (other than flake.lock and submodule
pointers) block automation in that repo. Blockers are reported for you to
resolve.
EOF
}

# ---------------------------------------------------------------- utilities

# --latest-flake-sync runs the head of flake-sync's flake in place of this
# copy, with the same arguments less the flag. --refresh keeps nix from
# answering with a github: ref it fetched within the last hour. The copy
# it starts sees FLAKE_SYNC_LATEST_ACTIVE and runs itself.
if [ "${FLAKE_SYNC_LATEST_ACTIVE:-}" != 1 ]; then
  latest_wanted=false
  latest_rest=()
  for latest_arg in "$@"; do
    if [ "$latest_arg" = --latest-flake-sync ]; then latest_wanted=true; else latest_rest+=("$latest_arg"); fi
  done
  if $latest_wanted; then
    export FLAKE_SYNC_LATEST_ACTIVE=1
    exec nix run --refresh "${FLAKE_SYNC_UPSTREAM:-github:clhodapp/flake-sync}" -- "${latest_rest[@]}"
  fi
fi

DRY_RUN=false
DO_FETCH=false
HEADS=false
LOCAL=false
CHECKOUT_MISSING=false
TRUST_LOCAL_CHECKS=false
CHECKOUT_ALL=false
PIN_FROM_DEFAULT=false
WITH_PARTITIONS=false
WITH_TESTS=false
WITH_EXTERNAL=false
CHECK_MODE="eval" # none, eval, or full

if [ -t 1 ]; then
  C_RED=$'\033[31m' C_GRN=$'\033[32m' C_YLW=$'\033[33m' C_BLD=$'\033[1m' C_OFF=$'\033[0m'
else
  C_RED='' C_GRN='' C_YLW='' C_BLD='' C_OFF=''
fi

die() { echo "flake-sync: error: $*" >&2; exit 1; }

run() {
  echo "${C_BLD}+ $*${C_OFF}"
  if ! $DRY_RUN; then "$@"; fi
}

# ------------------------------------------------------------- repo model
#
# Every repo (submodules + the workspace itself) is keyed by name.

# The workspace root comes from the caller's cwd, not from the location of
# this script: find the enclosing git repo, then walk up as long as the
# current repo is registered as a submodule of an enclosing one, ending at
# the parent-most superproject. A repo that is not a submodule of another repo is a
# root by itself; a cwd outside any git repo is an error.
find_root() {
  local top super
  top=$(git rev-parse --show-toplevel 2>/dev/null) \
    || die "not inside a git repository (run from within a workspace checkout)"
  while super=$(git -C "$top" rev-parse --show-superproject-working-tree 2>/dev/null) \
    && [ -n "$super" ]; do
    top=$super
  done
  printf '%s\n' "$top"
}
ROOT=$(find_root)
[ -f "$ROOT/.gitmodules" ] || die "$ROOT has no .gitmodules"
WS=  # set by discover_repos

declare -A DIR=()        # repo -> absolute path
declare -A SUBPATH=()    # repo -> path relative to $ROOT (submodules only)
declare -A GH2REPO=()    # "owner/repo" -> repo name
declare -A URL2REPO=()   # normalized non-github remote URL -> repo name
declare -A PINBASE=()    # repo -> flake ref base ("github:o/r" or "git+file://...")
declare -A BRANCH=()     # repo -> branch name or "(detached)"
declare -A HEADREV=()    # repo -> HEAD rev
declare -A AHEAD=()      # repo -> commits not on any remote
declare -A BEHIND=()     # repo -> commits behind upstream (0 if no upstream)
declare -A HAS_UPSTREAM=()
declare -A DIRTY=()      # repo -> blocking-dirty description ("" if clean)
declare -A LOCK_DIRTY=() # repo -> "yes" if flake.lock has uncommitted changes
declare -A PINS=()       # repo -> lines "input<TAB>target-repo<TAB>locked-rev<TAB>flakedir"
declare -A EXTPINS=()    # repo -> lines "input<TAB>locked-rev<TAB>flakedir" (non-sibling root inputs)
declare -A EXTSTALE=()   # "repo<TAB>input<TAB>flakedir" -> "stale" or "ok" (populated with --with-external)
declare -A EXTURL=()     # same key -> exact-rev override ref for a stale external pin (resolved by its trial lock)
declare -A DEPS=()       # repo -> space-separated dep repo names
declare -A STALE_PTR=()  # workspace only: lines "repo<TAB>recorded-rev"
declare -A ABSENT=()     # repo -> path, for a submodule that is not checked out here
declare -A ABSENTURL=()  # repo -> its remote URL from .gitmodules
declare -A ABSENTNAME=() # repo -> its submodule name in .gitmodules
declare -A SLUG=()       # repo -> GitHub owner/repo of its remote, for a GitHub remote
declare -A ABSENT_READ=() # repo -> 1 once read_absent_state has read it
declare -A UNCOMMITTED_LOCKS=() # repo -> managed lock paths that differ from HEAD
declare -A ABSENTBRANCH=() # repo -> its remote's default branch, when known
TOPO=()

gh_slug() { # normalize a github remote URL to owner/repo, empty otherwise
  local url=$1
  case $url in
    git@github.com:*) url=${url#git@github.com:} ;;
    https://github.com/*) url=${url#https://github.com/} ;;
    ssh://git@github.com/*) url=${url#ssh://git@github.com/} ;;
    *) return 0 ;;
  esac
  url=${url%/}; url=${url%.git}
  case $url in
    */*/*) ;;
    ?*/?*) echo "$url" ;;
  esac
}

norm_url() { # canonicalize a git/file remote URL for matching
  local url=$1
  url=${url#git+}
  case $url in /*) url="file://$url" ;; esac
  url=${url%/}; url=${url%.git}
  echo "$url"
}

discover_repos() {
  # Name the workspace after its origin repo when possible; a worktree's
  # directory basename would be misleading.
  local ws_slug
  ws_slug=$(gh_slug "$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)")
  WS=${ws_slug##*/}
  [ -n "$WS" ] || WS=$(basename "$ROOT")
  DIR[$WS]=$ROOT
  [ -z "$ws_slug" ] || SLUG[$WS]=$ws_slug
  local key path url name
  while read -r key path; do
    name=$(basename "$path")
    [ "$name" != "$WS" ] || die "submodule name collides with workspace name '$WS'"
    url=$(git config -f "$ROOT/.gitmodules" "${key%.path}.url")
    if [ -e "$ROOT/$path/.git" ] && ! $PIN_FROM_DEFAULT; then
      [ -f "$ROOT/$path/flake.nix" ] || continue
      DIR[$name]=$ROOT/$path
    else
      # Not checked out here, or pinned from its default branch: read_absent_state
      # reads it from its remote, and drops it there if it is not a flake.
      ABSENT[$name]=$path
      ABSENTURL[$name]=$url
      ABSENTNAME[$name]=${key#submodule.}
      ABSENTNAME[$name]=${ABSENTNAME[$name]%.path}
    fi
    SUBPATH[$name]=$path
    local slug; slug=$(gh_slug "$url")
    if [ -n "$slug" ]; then
      SLUG[$name]=$slug
      GH2REPO[$slug]=$name
      PINBASE[$name]="github:$slug"
    else
      URL2REPO[$(norm_url "$url")]=$name
      case $url in
        git+*) PINBASE[$name]=$url ;;
        /*) PINBASE[$name]="git+file://$url" ;;
        *) PINBASE[$name]="git+$url" ;;
      esac
    fi
  done < <(git config -f "$ROOT/.gitmodules" --get-regexp '^submodule\..*\.path$')
  return 0
}

fetch_absent() { # write absent repo $1's head rev and source store path to $EXTTMP/absent-$1.*
  local repo=$1 out=$EXTTMP/absent-$1 rev="" ref heads=""
  # With --fetch, the head of its remote; otherwise the recorded pointer,
  # the newest commit the checkout knows without the network.
  if $DO_FETCH; then
    heads=$(git ls-remote --symref "${ABSENTURL[$repo]}" HEAD 2>/dev/null || true)
    rev=$(awk '$2 == "HEAD" && $1 != "ref:" { print $1 }' <<<"$heads")
    awk '$1 == "ref:" { sub("^refs/heads/", "", $2); print $2 }' <<<"$heads" >"$out.branch"
    [ -n "$rev" ] || echo "${C_YLW}warning: fetch failed for $repo; using the recorded pointer${C_OFF}" >&2
  fi
  [ -n "$rev" ] || rev=$(git -C "$ROOT" ls-tree HEAD -- "${ABSENT[$repo]}" | awk '{print $3}')
  echo "$rev" >"$out.rev"
  [ -n "$rev" ] || return 0
  case ${PINBASE[$repo]} in
    github:*) ref=${PINBASE[$repo]}/$rev ;;
    *) ref="${PINBASE[$repo]}?rev=$rev" ;;
  esac
  nix flake prefetch --json "$ref" >"$out.json" 2>"$out.err" || true
}

absent_dropped() { # is absent repo $1 no workspace flake? (not in the tree, or no flake.nix)
  local out=$EXTTMP/absent-$1 src
  [ -n "$(cat "$out.rev")" ] || return 0
  src=$(jq -r '.storePath // empty' "$out.json" 2>/dev/null || true)
  [ -n "$src" ] && [ ! -f "$src/flake.nix" ]
}

drop_absent() { # forget absent repo $1, as discovery skips a checked-out non-flake: pins onto it count as external
  local repo=$1
  if [ -n "${SLUG[$repo]:-}" ]; then
    unset "GH2REPO[${SLUG[$repo]}]" "SLUG[$repo]"
  else
    unset "URL2REPO[$(norm_url "${ABSENTURL[$repo]}")]"
  fi
  unset "ABSENT[$repo]" "SUBPATH[$repo]" "PINBASE[$repo]"
}

read_absent_state() { # state of absent repo $1 from the files fetch_absent wrote
  local repo=$1 out=$EXTTMP/absent-$1 rev src sub fd
  rev=$(cat "$out.rev")
  src=$(jq -r '.storePath // empty' "$out.json" 2>/dev/null || true)
  HEADREV[$repo]=$rev
  BRANCH[$repo]="(not checked out)"
  [ ! -s "$out.branch" ] || ABSENTBRANCH[$repo]=$(cat "$out.branch")
  AHEAD[$repo]=0 BEHIND[$repo]=0 HAS_UPSTREAM[$repo]=no
  DIRTY[$repo]="" LOCK_DIRTY[$repo]=no
  PINS[$repo]='' DEPS[$repo]='' EXTPINS[$repo]=''
  ABSENT_READ[$repo]=1
  if [ -z "$src" ]; then
    echo "${C_YLW}warning: cannot fetch $repo at ${rev:0:12}, so its pins are not assessed: $(tail -1 "$out.err")${C_OFF}" >&2
    return 0
  fi
  read_lock_pins "$repo" "$src/flake.lock" "."
  if $WITH_PARTITIONS; then
    while IFS= read -r sub; do
      fd=${sub#"$src"/}; fd=$(dirname "$fd")
      [ -f "$src/$fd/flake.nix" ] || continue
      read_lock_pins "$repo" "$sub" "$fd"
    done < <(find "$src" -mindepth 2 -name flake.lock | sort)
  fi
}

read_absent_states() { # fetch every unread absent repo, in parallel, then read each
  local repo todo=()
  for repo in ${ABSENT[@]+"${!ABSENT[@]}"}; do
    [ -n "${ABSENT_READ[$repo]:-}" ] || todo+=("$repo")
  done
  [ ${#todo[@]} -gt 0 ] || return 0
  ext_tmpdir >/dev/null
  echo "reading ${#todo[@]} repo(s) not checked out here from their remotes..." >&2
  for repo in "${todo[@]}"; do
    while [ "$(jobs -rp | wc -l)" -ge "$FETCH_JOBS" ]; do wait -n || true; done
    fetch_absent "$repo" &
  done
  wait || true
  # Every drop comes first, so no lock read below maps a pin onto a
  # dropped repo.
  local keep=()
  for repo in "${todo[@]}"; do
    if absent_dropped "$repo"; then drop_absent "$repo"; else keep+=("$repo"); fi
  done
  for repo in ${keep[@]+"${keep[@]}"}; do read_absent_state "$repo"; done
}

read_git_state() {
  local repo=$1 dir=${DIR[$1]}
  HEADREV[$repo]=$(git -C "$dir" rev-parse HEAD)
  BRANCH[$repo]=$(git -C "$dir" symbolic-ref --quiet --short HEAD || echo "(detached)")
  AHEAD[$repo]=$(git -C "$dir" rev-list --count HEAD --not --remotes)
  if git -C "$dir" rev-parse --quiet --verify '@{u}' >/dev/null 2>&1; then
    HAS_UPSTREAM[$repo]=yes
    BEHIND[$repo]=$(git -C "$dir" rev-list --count 'HEAD..@{u}')
  else
    # No @{u} on a detached HEAD (the normal post-`submodule update` state):
    # fall back to the remote's default branch so staleness is still
    # detected instead of silently reading as 0.
    HAS_UPSTREAM[$repo]=no
    local default_ref
    default_ref=$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo "")
    if [ -n "$default_ref" ]; then
      BEHIND[$repo]=$(git -C "$dir" rev-list --count "HEAD..$default_ref")
    else
      BEHIND[$repo]=0
    fi
  fi

  # Blocking dirt: tracked changes other than flake.lock; for the workspace,
  # submodule pointer changes are handled separately, not as dirt.
  local ignore=() line dirty=0 lockdirty=no
  [ "$repo" = "$WS" ] && ignore=(--ignore-submodules=all)
  while IFS= read -r line; do
    case ${line:0:2} in '??') continue ;; esac
    case ${line:3} in
      flake.lock | */flake.lock) lockdirty=yes ;;
      *) dirty=$((dirty + 1)) ;;
    esac
  done < <(git -C "$dir" status --porcelain "${ignore[@]}")
  DIRTY[$repo]=$([ "$dirty" -gt 0 ] && echo "$dirty uncommitted change(s)" || echo "")
  LOCK_DIRTY[$repo]=$lockdirty
}

read_lock_pins() { # append sibling-repo (and, with --with-external, external) pins from one lock; $3 = flake dir rel to repo ("." = root)
  local repo=$1 lock=$2 fd=$3
  [ -f "$lock" ] || return 0
  local input kind key rev target
  while IFS=$'\t' read -r input kind key rev; do
    case $kind in
      gh) target=${GH2REPO[$key]:-} ;;
      git) target=${URL2REPO[$(norm_url "$key")]:-} ;;
      *) target="" ;;
    esac
    if [ -n "$target" ] && [ "$target" != "$repo" ]; then
      PINS[$repo]+="$input	$target	$rev	$fd"$'\n'
      case " ${DEPS[$repo]} " in *" $target "*) ;; *) DEPS[$repo]+="$target " ;; esac
    elif [ -z "$target" ] && $WITH_EXTERNAL; then
      EXTPINS[$repo]+="$input	$rev	$fd"$'\n'
    fi
  done < <(jq -r '
    . as $L | ($L.nodes[$L.root].inputs // {}) | to_entries[]
    | select(.value | type == "string")
    | . as $e | $L.nodes[$e.value].locked // {}
    | if .type == "github" then "\($e.key)\tgh\t\(.owner)/\(.repo)\t\(.rev)"
      elif .type == "git" then "\($e.key)\tgit\t\(.url)\t\(.rev)"
      else empty end' "$lock")
  return 0
}

read_pins() { # sibling-repo (+ external, with --with-external) pins from the root lock (+ partition locks with --with-partitions)
  local repo=$1 dir=${DIR[$1]}
  PINS[$repo]='' DEPS[$repo]='' EXTPINS[$repo]='' UNCOMMITTED_LOCKS[$repo]=''
  read_managed_lock "$repo" flake.lock "."
  if $WITH_PARTITIONS; then
    local sub fd
    while IFS= read -r sub; do
      fd=$(dirname "$sub")
      [ -f "$dir/$fd/flake.nix" ] || continue
      read_managed_lock "$repo" "$sub" "$fd"
    done < <(git -C "$dir" ls-files -- '*/flake.lock')
  fi
  return 0
}

read_managed_lock() { # pins of lock $2 (path in repo $1) for flake dir $3
  local repo=$1 path=$2 fd=$3 dir=${DIR[$1]} lock
  lock=$dir/$path
  # --local manages the working trees, so it reads their locks. Otherwise
  # the committed lock is the published state: a pin advanced only in the
  # working tree is still stale, and update-pins commits it.
  if ! $LOCAL && git -C "$dir" cat-file -e "HEAD:$path" 2>/dev/null; then
    ext_tmpdir >/dev/null
    lock=$EXTTMP/head-$repo-${path//\//_}
    git -C "$dir" show "HEAD:$path" >"$lock"
    git -C "$dir" diff --quiet HEAD -- "$path" || UNCOMMITTED_LOCKS[$repo]+="$path "
  fi
  read_lock_pins "$repo" "$lock" "$fd"
}

EXTTMP=
ext_tmpdir() { # lazily create, and register cleanup for, a scratch dir for trial lock files
  if [ -z "$EXTTMP" ]; then
    EXTTMP=$(mktemp -d) || die "cannot create scratch dir for external-pin trials"
    trap 'rm -rf "$EXTTMP"' EXIT
  fi
  echo "$EXTTMP"
}

read_ext_staleness() { # populate EXTSTALE/EXTURL for repo $1's external pins: does `nix flake update <input>` move the lock, and to what?
  local repo=$1 dir=${DIR[$1]} input rev fd flakedir trial new_rev new_url
  while IFS=$'\t' read -r input rev fd; do
    [ -n "$input" ] || continue
    flakedir=$dir; [ "$fd" = "." ] || flakedir=$dir/$fd
    trial=$(ext_tmpdir)/$repo-$fd-$input.lock
    mkdir -p "$(dirname "$trial")"
    new_rev="" new_url=""
    if nix flake update "$input" --flake "$flakedir" --output-lock-file "$trial" \
        >/dev/null 2>&1; then
      # The trial lock's resolved rev doubles as the advance target: the
      # override ref built here is what update-pins locks to, so the gate
      # checks and the lock writes one and the same rev.
      IFS=$'\t' read -r new_rev new_url < <(jq -r --arg i "$input" '
        .nodes[.nodes[.root].inputs[$i]].locked // {}
        | if .type == "github" then "\(.rev)\tgithub:\(.owner)/\(.repo)/\(.rev)"
          elif .type == "git" then "\(.rev)\tgit+\(.url)?rev=\(.rev)\(if .ref then "&ref=\(.ref)" else "" end)"
          else empty end' "$trial") || true
    fi
    if [ -n "$new_rev" ] && [ "$new_rev" != "$rev" ]; then
      EXTSTALE["$repo	$input	$fd"]=stale
      EXTURL["$repo	$input	$fd"]=$new_url
    else
      EXTSTALE["$repo	$input	$fd"]=ok
    fi
  done <<<"${EXTPINS[$repo]:-}"
  return 0
}

read_pointer_state() { # workspace submodule pointers vs submodule HEADs
  STALE_PTR[$WS]=''
  local repo recorded
  for repo in "${!SUBPATH[@]}"; do
    [ -n "${HEADREV[$repo]:-}" ] || continue # absent and unread (pull)
    recorded=$(git -C "$ROOT" ls-tree HEAD -- "${SUBPATH[$repo]}" | awk '{print $3}')
    if [ -n "$recorded" ] && [ "$recorded" != "${HEADREV[$repo]}" ]; then
      STALE_PTR[$WS]+="$repo	$recorded"$'\n'
    fi
  done
}

is_pushed() { # is $2 (default HEAD) of repo $1 reachable from some remote ref?
  local rev=${2:-${HEADREV[$1]}}
  # An absent repo's head is read from its remote or the recorded pointer.
  [ -z "${ABSENT[$1]:-}" ] || return 0
  [ "$(git -C "${DIR[$1]}" rev-list --count "$rev" --not --remotes)" = 0 ]
}

toposort() {
  # Kahn's algorithm over DEPS; workspace additionally depends on every
  # submodule (pointer bumps must come last).
  local -A remaining=()
  local repo dep progressed
  for repo in "${!DIR[@]}" ${ABSENT[@]+"${!ABSENT[@]}"}; do
    local deps="${DEPS[$repo]:-}"
    [ "$repo" = "$WS" ] && for dep in "${!SUBPATH[@]}"; do deps+="$dep "; done
    remaining[$repo]=$deps
  done
  TOPO=()
  while [ ${#remaining[@]} -gt 0 ]; do
    progressed=no
    for repo in $(printf '%s\n' "${!remaining[@]}" | sort); do
      local unmet=no
      for dep in ${remaining[$repo]}; do
        [ -n "${remaining[$dep]+x}" ] && { unmet=yes; break; }
      done
      if [ "$unmet" = no ]; then
        TOPO+=("$repo"); unset "remaining[$repo]"; progressed=yes
      fi
    done
    [ "$progressed" = yes ] || die "dependency cycle among: ${!remaining[*]}$($WITH_PARTITIONS && echo " (partition/dev pins can create cycles that have no convergent fixpoint; break the cycle or drop --with-partitions)")"
  done
}

refresh_state() { # re-read git/pin state for every repo (after a mutating action, or for the initial load)
  local repo
  # An absent repo that an action checked out joins the checked-out ones.
  for repo in ${ABSENT[@]+"${!ABSENT[@]}"}; do
    if ! $PIN_FROM_DEFAULT && [ -e "$ROOT/${ABSENT[$repo]}/.git" ]; then
      DIR[$repo]=$ROOT/${ABSENT[$repo]}
      unset "ABSENT[$repo]" "ABSENT_READ[$repo]"
    fi
  done
  # Pinning from the default branches moves those branches on the remote,
  # so their state is read again after each action.
  ! $PIN_FROM_DEFAULT || ABSENT_READ=()
  # pull clones or leaves out absent submodules itself, from .gitmodules.
  [ "$CMD" = pull ] || read_absent_states
  for repo in "${!DIR[@]}"; do
    read_git_state "$repo"
    read_pins "$repo"
  done
  if $WITH_EXTERNAL; then
    for repo in "${!DIR[@]}"; do read_ext_staleness "$repo"; done
  fi
  read_pointer_state
}

FETCH_JOBS=8

fetch_repo() { # refresh repo $1's remote-tracking refs as far as flake-sync reads them
  local repo=$1 dir=${DIR[$1]} remote=origin default="" branch upstream refspecs=()
  # The checked-out branch's upstream remote, if it has one, else origin.
  branch=$(git -C "$dir" symbolic-ref --short -q HEAD || true)
  upstream=""
  if [ -n "$branch" ]; then
    upstream=$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
    [ -z "$upstream" ] || remote=${upstream%%/*}
  fi
  default=$(git -C "$dir" symbolic-ref --short -q "refs/remotes/$remote/HEAD" || true)
  default=${default#"$remote"/}
  # The default branch, plus the checked-out branch's upstream: the refs
  # pull, status and converge read for a repo checked out as usual.
  if [ -n "$default" ]; then
    refspecs+=("+refs/heads/$default:refs/remotes/$remote/$default")
    if [ -n "$upstream" ] && [ "${upstream#"$remote"/}" != "$default" ]; then
      refspecs+=("+refs/heads/${upstream#"$remote"/}:refs/remotes/$upstream")
    fi
  fi
  if [ ${#refspecs[@]} -gt 0 ] \
    && git -C "$dir" fetch --quiet --no-tags "$remote" "${refspecs[@]}" 2>/dev/null \
    && { [ -z "$(git -C "$dir" for-each-ref --count=1 --format=x refs/remotes)" ] \
         || [ -n "$(git -C "$dir" for-each-ref --count=1 --format=x --contains HEAD refs/remotes)" ]; }; then
    return 0
  fi
  # The narrow fetch could not run, or HEAD is on no remote-tracking ref:
  # HEAD may sit on a remote branch that is not checked out, which only a
  # full fetch reveals before is_pushed judges it.
  git -C "$dir" fetch --quiet || echo "${C_YLW}warning: fetch failed for $repo${C_OFF}" >&2
}

load_state() {
  discover_repos
  local repo
  if $DO_FETCH; then
    echo "fetching ${#DIR[@]} repos..." >&2
    for repo in "${!DIR[@]}"; do
      while [ "$(jobs -rp | wc -l)" -ge "$FETCH_JOBS" ]; do wait -n || true; done
      fetch_repo "$repo" &
    done
    wait || true
  fi
  refresh_state
  toposort
}

# ------------------------------------------------------------------- plan
#
# PLAN holds lines: "READY|action|repo|detail" or "BLOCKED|action|repo|reason",
# in execution order (topological, pins before pushes).

PLAN=()

stale_pin_inputs() { # ready-to-advance stale pins of $1: "input<TAB>target<TAB>flakedir"
  local repo=$1 input target rev fd
  while IFS=$'\t' read -r input target rev fd; do
    [ -n "$input" ] || continue
    [ "$rev" = "${HEADREV[$target]}" ] && continue
    is_pushed "$target" && echo "$input	$target	$fd"
  done <<<"${PINS[$repo]:-}"
  return 0
}

blocked_pin_targets() { # stale inputs of $1 whose target rev is unpushed
  local repo=$1 input target rev fd
  while IFS=$'\t' read -r input target rev fd; do
    [ -n "$input" ] || continue
    [ "$rev" = "${HEADREV[$target]}" ] && continue
    is_pushed "$target" || echo "$target"
  done <<<"${PINS[$repo]:-}" | sort -u
}

stale_ext_inputs() { # stale external pins of $1 (--with-external only): "input<TAB>flakedir<TAB>override-ref"
  $WITH_EXTERNAL || return 0
  local repo=$1 input rev fd
  while IFS=$'\t' read -r input rev fd; do
    [ -n "$input" ] || continue
    [ "${EXTSTALE["$repo	$input	$fd"]:-ok}" = stale ] && echo "$input	$fd	${EXTURL["$repo	$input	$fd"]}"
  done <<<"${EXTPINS[$repo]:-}"
  return 0
}

pin_label() { # "input" for the root lock, "dir:input" for partition locks
  [ "$2" = "." ] && echo "$1" || echo "$2:$1"
}

stray_test_locks() { # untracked flake.lock files next to a tracked flake.nix in $1
  local repo=$1 dir=${DIR[$1]} f d
  while IFS= read -r f; do
    d=$(dirname "$f")
    git -C "$dir" ls-files --error-unmatch "$d/flake.lock" >/dev/null 2>&1 && continue
    [ -f "$dir/$d/flake.lock" ] && echo "$d/flake.lock"
  done < <(git -C "$dir" ls-files -- '*/flake.nix')
  return 0
}

build_plan() {
  PLAN=()
  local repo
  for repo in "${TOPO[@]}"; do
    # The workspace repo's topic branch takes no pin moves either; its pins
    # and pointers move by convergence of its default branch.
    if $PIN_FROM_DEFAULT && [ "$repo" = "$WS" ]; then
      PLAN+=("WARN|workspace|$WS|its pins and submodule pointers move by convergence of its default branch, not from a linked worktree")
      continue
    fi
    local ready blocked extready
    ready=$(stale_pin_inputs "$repo")
    blocked=$(blocked_pin_targets "$repo")
    extready=$(stale_ext_inputs "$repo")
    if [ -n "$ready" ] || [ -n "$blocked" ] || [ -n "$extready" ]; then
      local names extnames blockednames
      names=$(awk -F'\t' 'NF { print ($3 == "." ? $1 : $3 ":" $1) }' <<<"$ready" | paste -sd, -)
      extnames=$(awk -F'\t' 'NF { print ($2 == "." ? $1 : $2 ":" $1) }' <<<"$extready" | paste -sd, -)
      [ -n "$extnames" ] && names=${names:+$names,}$extnames
      blockednames=$(paste -sd, - <<<"$blocked")
      # A pin that cannot advance (unpushed target, failing check) holds back
      # only itself: sibling pins still advance, with nix flake check
      # arbitrating which partial states are publishable. Dirty trees and
      # detached HEADs only endanger commits, so --local ignores them.
      if [ -n "${ABSENT[$repo]:-}" ]; then
        # Advancing needs a checkout; pins that cannot advance do not.
        if [ -z "$ready" ] && [ -z "$extready" ]; then
          PLAN+=("BLOCKED|update-pins|$repo|stale pin(s) to unpushed target(s): $blockednames")
        elif $PIN_FROM_DEFAULT; then
          PLAN+=("READY|pin-on-default|$repo|advance pins on its default branch: $names")
        elif $CHECKOUT_MISSING; then
          PLAN+=("READY|checkout|$repo|not checked out here; clone it to advance pins: $names")
        else
          PLAN+=("BLOCKED|update-pins|$repo|stale pins ($names) but not checked out here; rerun with --checkout-missing, or run 'flake-sync checkout $repo'")
        fi
      elif ! $LOCAL && [ -n "${DIRTY[$repo]}" ]; then
        PLAN+=("BLOCKED|update-pins|$repo|stale pins (${names:-$blockednames}) but repo has ${DIRTY[$repo]}")
      elif ! $LOCAL && [ "${BRANCH[$repo]}" = "(detached)" ]; then
        PLAN+=("BLOCKED|update-pins|$repo|stale pins (${names:-$blockednames}) but HEAD is detached; check out a branch")
      elif [ -n "$ready" ] || [ -n "$extready" ]; then
        local detail="advance pins: $names"
        [ -n "$blocked" ] && detail+=" (holding pins to unpushed: $blockednames)"
        PLAN+=("READY|update-pins|$repo|$detail")
      else
        PLAN+=("BLOCKED|update-pins|$repo|stale pin(s) to unpushed target(s): $blockednames")
      fi
    fi

    if $WITH_TESTS; then
      local strays
      strays=$(stray_test_locks "$repo")
      [ -n "$strays" ] && PLAN+=("WARN|test-locks|$repo|stray untracked lock(s): $(paste -sd, - <<<"$strays"); unlocked test flakes get their inputs via nix wiring, so a stray lock silently pins standalone runs; delete it (or track it to manage it)")
    fi

    # Everything below plans commits and pushes, that is publication, which --local
    # leaves entirely to CI convergence (or a full local converge).
    $LOCAL && continue

    # A managed lock that differs from HEAD with no pin update planned to
    # commit it holds changes flake-sync does not make, such as an external
    # bump without --with-external.
    if [ -n "${UNCOMMITTED_LOCKS[$repo]:-}" ] && [ -z "$ready" ] && [ -z "$extready" ]; then
      PLAN+=("BLOCKED|commit|$repo|uncommitted changes in ${UNCOMMITTED_LOCKS[$repo]% } that are not pin updates flake-sync manages; commit or discard them")
    fi

    if [ "$repo" = "$WS" ] && [ -n "${STALE_PTR[$WS]}" ]; then
      local bumpable=() waiting=() sub
      while IFS=$'\t' read -r sub _; do
        [ -n "$sub" ] || continue
        if is_pushed "$sub"; then bumpable+=("$sub"); else waiting+=("$sub"); fi
      done <<<"${STALE_PTR[$WS]}"
      [ ${#bumpable[@]} -gt 0 ] && PLAN+=("READY|bump-submodules|$WS|record new pointer(s): ${bumpable[*]}")
      [ ${#waiting[@]} -gt 0 ] && PLAN+=("BLOCKED|bump-submodules|$WS|pointer(s) stale but unpushed: ${waiting[*]}")
    fi

    if [ "${AHEAD[$repo]}" -gt 0 ]; then
      if [ "${BRANCH[$repo]}" = "(detached)" ]; then
        PLAN+=("BLOCKED|push|$repo|${AHEAD[$repo]} unpushed commit(s) on detached HEAD")
      elif [ "${BEHIND[$repo]}" -gt 0 ]; then
        PLAN+=("BLOCKED|push|$repo|behind upstream by ${BEHIND[$repo]}; pull/rebase first")
      else
        PLAN+=("READY|push|$repo|push ${AHEAD[$repo]} commit(s) on ${BRANCH[$repo]}")
      fi
    elif [ "${BEHIND[$repo]}" -gt 0 ]; then
      # Nothing to push, so the branch above never fires. Without this,
      # a local checkout can drift arbitrarily far behind its remote
      # (e.g. left on detached HEAD after `submodule update`) with no
      # actionable signal, only a color in `status`'s git column.
      if [ "${BRANCH[$repo]}" = "(detached)" ]; then
        PLAN+=("BLOCKED|pull|$repo|detached HEAD is behind upstream by ${BEHIND[$repo]}; run 'flake-sync pull'")
      else
        PLAN+=("BLOCKED|pull|$repo|behind upstream by ${BEHIND[$repo]}; run 'flake-sync pull'")
      fi
    fi

    [ -n "${DIRTY[$repo]}" ] && PLAN+=("BLOCKED|commit|$repo|${DIRTY[$repo]} need manual commit")
  done
  return 0
}

# ---------------------------------------------------------------- actions

report_held() { # after a partial advance of $1: fail loudly about held-back pins ($2)
  [ -n "$2" ] || return 0
  die "$1 advanced what it could; held back: $2"
}

pin_override_args() { # print --override-input args (one per line) for pins of flake dir $2 in $1 whose target is in $3
  local lines=$1 fd=$2 targets=" $3 " input target f2 base ref
  while IFS=$'\t' read -r input target f2; do
    [ "$f2" = "$fd" ] || continue
    case $targets in *" $target "*) ;; *) continue ;; esac
    base=${PINBASE[$target]:-}
    [ -n "$base" ] || die "no pin base URL known for $target"
    case $base in
      github:*) ref="$base/${HEADREV[$target]}" ;;
      *)
        ref="$base?rev=${HEADREV[$target]}"
        if [ -n "${ABSENT[$target]:-}" ]; then
          [ -z "${ABSENTBRANCH[$target]:-}" ] || ref+="&ref=refs/heads/${ABSENTBRANCH[$target]}"
        elif [ "${BRANCH[$target]}" != "(detached)" ]; then
          ref+="&ref=refs/heads/${BRANCH[$target]}"
        fi
        ;;
    esac
    printf '%s\n' --override-input "$input" "$ref"
  done <<<"$lines"
  return 0
}

ext_override_args() { # print --override-input args (one per line) for stale external pins of flake dir $2 in extlines $1
  local extlines=$1 fd=$2 input f2 ref
  while IFS=$'\t' read -r input f2 ref; do
    [ -n "$input" ] || continue
    [ "$f2" = "$fd" ] || continue
    printf '%s\n' --override-input "$input" "$ref"
  done <<<"$extlines"
  return 0
}

trial_args() { # print override args for flake dir $3, given trial target set $2 and sibling pin lines $1; extlines $4
  local lines=$1 trial=$2 fd=$3 extlines=$4
  case " $trial " in *" $EXT_PSEUDO_TARGET "*) ext_override_args "$extlines" "$fd" ;; esac
  pin_override_args "$lines" "$fd" "$trial"
}

# Pseudo-target standing in for "all stale external pins" in the step-wise
# trial loop: external pins have no sibling HEAD to pin to and no unpushed-
# target concept, so they cannot be tried one-by-one in dependency order like
# sibling targets. They are tried first, as one unit, so a failure holds back
# only external pins and sibling targets still get separate trials on a
# clean base.
EXT_PSEUDO_TARGET='__external__'

do_update_pins() {
  local repo=$1 dir=${DIR[$1]}
  if ! $LOCAL; then
    [ -z "${DIRTY[$repo]}" ] || die "$repo has ${DIRTY[$repo]}; commit or stash first"
    [ "${BRANCH[$repo]}" != "(detached)" ] || die "$repo is on a detached HEAD; check out a branch first"
  fi
  local held_unpushed
  held_unpushed=$(blocked_pin_targets "$repo" | paste -sd' ' -)
  local lines; lines=$(stale_pin_inputs "$repo")
  local extlines; extlines=$(stale_ext_inputs "$repo")
  [ -n "$lines" ] || [ -n "$extlines" ] \
    || die "no ready-to-advance stale pins in $repo${held_unpushed:+ (holding pin(s) to unpushed target(s): $held_unpushed)}"
  local fds=() input target fd
  while IFS=$'\t' read -r input target fd; do
    case " ${fds[*]-} " in *" $fd "*) ;; *) fds+=("$fd") ;; esac
  done <<<"$lines"
  while IFS=$'\t' read -r input fd _; do
    [ -n "$input" ] || continue
    case " ${fds[*]-} " in *" $fd "*) ;; *) fds+=("$fd") ;; esac
  done <<<"$extlines"
  # Step-wise checking: try the stale pin targets cumulatively in dependency
  # order, greedily growing the advancing set. A target whose trial state
  # fails `nix flake check` is held back alone, because the order is only a
  # linearization of the DAG, so an unrelated failure must not stop later
  # targets, and even a dependent of a held target may still advance (its
  # HEAD can be ahead of our pin regardless). The check arbitrates which
  # partial states are publishable. We advance a pin to its target's HEAD or
  # not at all: the goal is fewer stale pins, not smaller staleness.
  #
  # External pins have no sibling HEAD and no unpushed-target concept, so
  # they're tried first as a single pseudo-target ($EXT_PSEUDO_TARGET): a
  # failure holds back only external pins and sibling targets still get
  # separate trials on a clean base.
  local stale_targets=() t
  [ -n "$extlines" ] && stale_targets+=("$EXT_PSEUDO_TARGET")
  for t in "${TOPO[@]}"; do
    cut -f2 <<<"$lines" | grep -Fqx "$t" && stale_targets+=("$t")
  done
  local advance=() held_check=() args=() flakedir
  if [ "$CHECK_MODE" = none ]; then
    advance=("${stale_targets[@]}")
  else
    local check_flags=(--no-write-lock-file)
    [ "$CHECK_MODE" = eval ] && check_flags+=(--no-build)
    # check_trial: gate the trial target set $* through nix flake check for
    # every flake dir with stale pins. Runs in do_update_pins's scope (uses
    # its dir, fds, lines, extlines, check_flags via dynamic scoping).
    check_trial() {
      local trial=$* fd flakedir args=()
      for fd in "${fds[@]}"; do
        flakedir=$dir; [ "$fd" = "." ] || flakedir=$dir/$fd
        mapfile -t args < <(trial_args "$lines" "$trial" "$fd" "$extlines")
        [ ${#args[@]} -gt 0 ] || continue
        run nix flake check "$flakedir" "${check_flags[@]}" "${args[@]}" || return 1
      done
      return 0
    }
    # The full stale set is tried first. When everything is publishable
    # that is one check instead of N, and it is the only trial that can
    # pass pins that must move jointly: sibling repos each lock shared
    # deps (ch-flake et al), so advancing only some of them puts two revs
    # of the shared dep in one closure, which consumers that import its
    # flakeModule reject ("option ... is already declared"). In that case
    # every per-target trial fails individually while the union passes.
    if [ ${#stale_targets[@]} -gt 1 ] && check_trial "${stale_targets[@]}"; then
      advance=("${stale_targets[@]}")
    else
      [ ${#stale_targets[@]} -gt 1 ] \
        && echo "${C_YLW}full pin set fails nix flake check; trying targets step-wise${C_OFF}"
      for t in "${stale_targets[@]}"; do
        if check_trial ${advance[@]+"${advance[@]}"} "$t"; then
          advance=(${advance[@]+"${advance[@]}"} "$t")
        else
          held_check+=("$t")
          local tlabel=$t; [ "$t" = "$EXT_PSEUDO_TARGET" ] && tlabel="external pins"
          echo "${C_YLW}holding $tlabel (fails nix flake check); trying the remaining targets${C_OFF}"
        fi
      done
    fi
  fi
  local held_report="" hc
  if [ ${#held_check[@]} -gt 0 ]; then
    local held_labels=()
    for hc in "${held_check[@]}"; do
      [ "$hc" = "$EXT_PSEUDO_TARGET" ] && held_labels+=("external pins") || held_labels+=("$hc")
    done
    held_report="fail nix flake check ($CHECK_MODE): ${held_labels[*]}"
  fi
  [ -n "$held_unpushed" ] && held_report+="${held_report:+; }target unpushed: $held_unpushed"
  [ ${#advance[@]} -gt 0 ] || die "no pins advanced in $repo; held back: $held_report"
  local names=()
  while IFS=$'\t' read -r input t fd; do
    [ -n "$input" ] || continue
    case " ${advance[*]} " in *" $t "*) names+=("$(pin_label "$input" "$fd")") ;; esac
  done <<<"$lines"
  case " ${advance[*]} " in
    *" $EXT_PSEUDO_TARGET "*)
      while IFS=$'\t' read -r input fd _; do
        [ -n "$input" ] || continue
        names+=("$(pin_label "$input" "$fd")")
      done <<<"$extlines"
      ;;
  esac
  local paths=()
  for fd in "${fds[@]}"; do
    mapfile -t args < <(trial_args "$lines" "${advance[*]}" "$fd" "$extlines")
    [ ${#args[@]} -gt 0 ] || continue
    local lockpath=flake.lock
    flakedir=$dir
    if [ "$fd" != "." ]; then flakedir=$dir/$fd lockpath=$fd/flake.lock; fi
    run nix flake lock "$flakedir" "${args[@]}"
    paths+=("$lockpath")
  done
  if ! $DRY_RUN; then
    if git -C "$dir" diff --quiet -- "${paths[@]}" && git -C "$dir" diff --cached --quiet -- "${paths[@]}"; then
      echo "flake.lock unchanged in $repo; nothing to $($LOCAL && echo write || echo commit)"
      report_held "$repo" "$held_report"
      return 0
    fi
  fi
  if $LOCAL; then
    echo "${C_GRN}updated pins in $repo (working tree; not committed): ${names[*]}${C_OFF}"
    report_held "$repo" "$held_report"
    return 0
  fi
  local msg
  msg="maint: update flake pins ($(IFS=,; echo "${names[*]}"))"
  local trailer=()
  [ "$CHECK_MODE" = none ] || trailer=(-m "Checked-by: flake-sync --check=$CHECK_MODE")
  run git -C "$dir" commit --quiet -m "$msg" ${trailer[@]+"${trailer[@]}"} -- "${paths[@]}"
  echo "${C_GRN}updated pins in $repo: ${names[*]}${C_OFF}"
  report_held "$repo" "$held_report"
}

# The gh to run: FLAKE_SYNC_GH, else the caller's gh, which a credential
# wrapper may provide, else the packaged one (first on the PATH).
mapfile -t GH_ON_PATH < <(type -ap gh 2>/dev/null || true)
GH=${FLAKE_SYNC_GH:-${GH_ON_PATH[1]:-${GH_ON_PATH[0]:-gh}}}

push_via_pr() { # put repo $1's commits ahead of origin/$2, all pin commits, on $2 through a pull request merged at once; $3 = scratch for a temporary checkout
  local repo=$1 default=$2 scratch=${3:-} dir=${DIR[$1]} slug=${SLUG[$1]} subject branch url body file files locks
  subject=$(git -C "$dir" log --format=%s "origin/$default..HEAD" \
    | grep -v -e '^maint: update flake pins (' -e '^maint: bump ' | head -1 || true)
  [ -z "$subject" ] || die "$repo has commits on $default that are not flake-sync pin updates (first: '$subject'); a converge outside CI merges only pin updates. Move the other commits to a topic branch and open a pull request for them"
  # A pin move changes flake.lock files, and in the workspace repo also
  # submodule pointers, and nothing else. Its branch is named after what it
  # writes, so two runs that make the same move meet at one branch and one
  # pull request.
  local pointers=" ${SUBPATH[*]} "
  files=$(git -C "$dir" diff --name-only "origin/$default..HEAD")
  locks=""
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    if [ "${file##*/}" != flake.lock ]; then
      [ "$repo" = "$WS" ] && [[ $pointers == *" $file "* ]] \
        || die "$repo: the pin commits change $file; a pin move changes flake.lock files and submodule pointers only"
    fi
    locks+="$file $(git -C "$dir" rev-parse "HEAD:$file")"$'\n'
  done <<<"$files"
  [ -n "$locks" ] || die "$repo: the pin commits change nothing"
  branch=flake-sync/pins/$(printf '%s' "$locks" | git hash-object --stdin | cut -c1-12)
  if git -C "$dir" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    url=$("$GH" pr list -R "$slug" --head "$branch" --state open --json url --jq '.[0].url // empty' 2>/dev/null || true)
    die "$repo: the same pin move is already open on $branch${url:+ ($url)}; rerun once it merges"
  fi
  subject=$(git -C "$dir" log -1 --format=%s HEAD)
  body=$(printf 'Pin updates from flake-sync converge, merged at once:\n\n%s\n' "$(git -C "$dir" log --format='- %s' "origin/$default..HEAD")")
  run git -C "$dir" push --quiet origin "HEAD:refs/heads/$branch" || die "pushing $branch of $repo failed"
  if $DRY_RUN; then
    echo "${C_BLD}+ $GH pr create -R $slug --base $default --head $branch, then $GH pr merge --rebase${C_OFF}"
    return 0
  fi
  url=$("$GH" pr create -R "$slug" --base "$default" --head "$branch" --title "$subject" --body "$body") \
    || die "opening the pull request for $branch of $repo failed"
  # The merge uses the first method the repo allows, in the order rebase,
  # squash, merge commit; the next level pins whichever commit it puts on
  # the default branch.
  local method allowed
  allowed=$("$GH" api "repos/$slug" --jq '[(if .allow_rebase_merge then "rebase" else empty end), (if .allow_squash_merge then "squash" else empty end), (if .allow_merge_commit then "merge" else empty end)] | join(" ")' 2>/dev/null || echo rebase)
  method=${allowed%% *}
  [ -n "$method" ] || method=rebase
  local merged=false state=MERGED admin=()
  if $TRUST_LOCAL_CHECKS; then
    # The checks run here, and the merge overrides the branch protection
    # that would wait for the remote's CI.
    local check_flags=(--no-write-lock-file)
    [ "$CHECK_MODE" = eval ] && check_flags+=(--no-build)
    run nix flake check "$dir" "${check_flags[@]}" || die "$repo: local nix flake check failed; $url stays open"
    admin=(--admin)
  fi
  if run "$GH" pr merge -R "$slug" "$url" "--$method" ${admin[@]+"${admin[@]}"}; then
    merged=true
    run git -C "$dir" push --quiet origin --delete "$branch" || true
  else
    state=$("$GH" pr view -R "$slug" "$url" --json mergeStateStatus --jq .mergeStateStatus 2>/dev/null || echo UNKNOWN)
    case $state in
      DIRTY | BEHIND)
        # The default branch moved: a rerun recomputes the pins on it.
        run "$GH" pr close -R "$slug" "$url" --delete-branch || true ;;
      *)
        # Required checks or reviews: GitHub merges once they pass.
        run "$GH" pr merge -R "$slug" "$url" "--$method" --auto || true ;;
    esac
  fi
  # The local default branch follows the remote: the merge made new
  # commits, or the pin commit stays in the pull request, or a rerun
  # recomputes it.
  run git -C "$dir" fetch --quiet origin
  [ -n "$scratch" ] || run git -C "$dir" reset --quiet --keep "origin/$default" || die "$repo: could not move $default onto origin/$default"
  $merged || case $state in
    DIRTY | BEHIND) die "$repo: $default moved on the remote while converging; closed $url, rerun to recompute the pins" ;;
    *) die "$repo: $url could not be merged now (merge state $state); auto-merge is on, rerun once it merges" ;;
  esac
  echo "${C_GRN}merged the pin updates of $repo through $url ($method)${C_OFF}"
}

do_push() {
  local repo=$1 dir=${DIR[$1]}
  ! $LOCAL || die "push is publication; --local touches working trees only"
  [ "${BRANCH[$repo]}" != "(detached)" ] || die "$repo is on a detached HEAD"
  local default_branch
  default_branch=$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo origin/main)
  default_branch=${default_branch#origin/}
  local force=()
  if [ "${BRANCH[$repo]}" = "$default_branch" ]; then
    [ "${BEHIND[$repo]}" = 0 ] || die "$repo is behind upstream; pull/rebase first"
  else
    # A topic branch is rebased onto its default branch, so its push may
    # replace the remote tip, as long as that tip is part of the local
    # branch's history (its reflog included).
    force=(--force-with-lease --force-if-includes)
  fi
  if $LINKED; then
    # A topic branch goes to GitHub only once what it builds against is
    # there: no repo it depends on may hold unpushed commits.
    local dep waiting=()
    for dep in ${DEPS[$repo]:-}; do
      [ -n "${DIR[$dep]:-}" ] && [ "${AHEAD[$dep]}" -gt 0 ] && waiting+=("$dep")
    done
    [ ${#waiting[@]} -eq 0 ] || die "$repo depends on ${waiting[*]}, which has unpushed commits; push it first (step push <repo>)"
  fi
  # Outside CI, pin commits reach a GitHub default branch through a pull
  # request merged at once; CI convergence pushes them directly.
  if [ -n "${SLUG[$repo]:-}" ] && [ "${GITHUB_ACTIONS:-}" != true ]; then
    local default
    default=$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo origin/main)
    default=${default#origin/}
    if [ "${BRANCH[$repo]}" = "$default" ]; then
      push_via_pr "$repo" "$default"
      return
    fi
  fi
  local args=()
  [ "${HAS_UPSTREAM[$repo]}" = yes ] || args=(-u origin "${BRANCH[$repo]}")
  if ! run git -C "$dir" push --quiet ${force[@]+"${force[@]}"} ${args[@]+"${args[@]}"}; then
    # Most likely the remote moved while we worked (another checkout or
    # session pushed). Refresh our remote-tracking refs so status/plan report
    # "behind upstream" truthfully, then leave the rebase to the user.
    git -C "$dir" fetch --quiet || true
    local behind
    behind=$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo "?")
    die "push of $repo was rejected: the remote branch moved while we worked (now behind by $behind commit(s)). Rebase it yourself (for example git -C ${dir#"$ROOT"/} pull --rebase), then rerun."
  fi
  echo "${C_GRN}pushed $repo (${BRANCH[$repo]})${C_OFF}"
}

do_bump_submodules() {
  ! $LOCAL || die "bump-submodules is publication; --local touches working trees only"
  local paths=() names=() infos=() sub
  while IFS=$'\t' read -r sub _; do
    [ -n "$sub" ] || continue
    is_pushed "$sub" || continue
    paths+=("${SUBPATH[$sub]}"); names+=("$sub")
    infos+=(--cacheinfo "160000,${HEADREV[$sub]},${SUBPATH[$sub]}")
  done <<<"${STALE_PTR[$WS]:-}"
  [ ${#paths[@]} -gt 0 ] || die "no pushed submodule pointers to bump"
  local msg idx
  msg="maint: bump $(IFS=,; echo "${names[*]}")"
  # The commit is built from an index holding HEAD plus the new pointers, so
  # nothing else staged joins it, and a pointer is recorded whether or not
  # its submodule is checked out here.
  ext_tmpdir >/dev/null
  idx=$EXTTMP/bump-index
  run env GIT_INDEX_FILE="$idx" git -C "$ROOT" read-tree HEAD
  run env GIT_INDEX_FILE="$idx" git -C "$ROOT" update-index "${infos[@]}"
  run env GIT_INDEX_FILE="$idx" git -C "$ROOT" commit --quiet -m "$msg"
  run git -C "$ROOT" update-index "${infos[@]}"
  echo "${C_GRN}recorded submodule pointer(s): ${names[*]}${C_OFF}"
}

do_checkout() { # clone absent submodule $1 and attach it to its default branch, at origin's tip with $2 = heads, else at the recorded pointer
  local repo=$1 path=${ABSENT[$1]:-} gitdir common
  [ -n "$path" ] || die "$repo is already checked out"
  gitdir=$(git -C "$ROOT" rev-parse --path-format=absolute --git-dir)
  common=$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)
  if [ "$gitdir" != "$common" ]; then
    do_checkout_linked "$repo" "$common"
    return
  fi
  run git -C "$ROOT" submodule --quiet update --init -- "$path" || die "cloning $repo failed"
  $DRY_RUN && return 0
  local HEADS=false PULL_SYNCED=0 PULL_HELD=() PULL_NOTES=() # read and written by pull_sub
  [ "${2:-}" != heads ] || HEADS=true
  pull_sub "$path" HEAD
  [ ${#PULL_HELD[@]} -eq 0 ] || die "checked out $repo but could not attach it: ${PULL_HELD[*]}"
  echo "${C_GRN}checked out $repo at $path, on its default branch at $($HEADS && echo "origin's tip" || echo "the recorded pointer")${C_OFF}"
}

do_checkout_linked() { # in a linked worktree of the workspace, check out absent submodule $1 from the module repo in common git dir $2
  local repo=$1 common=$2 path=${ABSENT[$1]} module branch start tmp
  # Every worktree of the workspace shares one repo per submodule, the one
  # git keeps in the common git dir: objects, refs and fetches are shared,
  # and each worktree's checkout is a linked worktree of it.
  module=$common/modules/${ABSENTNAME[$repo]}
  branch=$(git -C "$ROOT" symbolic-ref --quiet --short HEAD) \
    || die "the workspace worktree is on a detached HEAD; check out a branch, whose name the submodule branch takes"
  if [ -d "$module" ]; then
    run git -C "$module" fetch --quiet origin || echo "${C_YLW}warning: fetch failed for $repo; starting from the refs already fetched${C_OFF}" >&2
    run git -C "$module" worktree prune
  else
    tmp=$(mktemp -d)
    run git clone --quiet --no-checkout --separate-git-dir="$module" "${ABSENTURL[$repo]}" "$tmp/clone" \
      || { rm -rf "$tmp"; die "cloning $repo failed"; }
    rm -rf "$tmp"
  fi
  $DRY_RUN && return 0
  start=$(git -C "$module" symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo origin/main)
  if git -C "$module" show-ref --verify --quiet "refs/heads/$branch"; then
    run git -C "$module" worktree add --quiet "$ROOT/$path" "$branch" \
      || die "checking out the existing branch $branch of $repo failed"
  else
    # --no-track: the branch is a topic branch, whose pushes go to a branch
    # of the same name rather than to the remote default branch.
    run git -C "$module" worktree add --quiet --no-track -b "$branch" "$ROOT/$path" "$start" \
      || die "creating branch $branch of $repo failed"
  fi
  echo "${C_GRN}checked out $repo at $path, on branch $branch from $start, sharing the workspace's repo for it${C_OFF}"
}

do_pin_on_default() { # move repo $1's pins on its remote default branch, in a temporary worktree of its module repo
  local repo=$1 common module default tmp status=0
  [ -n "${ABSENTNAME[$repo]:-}" ] || die "$repo is not a submodule of the workspace"
  common=$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)
  module=$common/modules/${ABSENTNAME[$repo]}
  if [ ! -d "$module" ]; then
    tmp=$(mktemp -d)
    run git clone --quiet --no-checkout --separate-git-dir="$module" "${ABSENTURL[$repo]}" "$tmp/clone" \
      || { rm -rf "$tmp"; die "cloning $repo failed"; }
    rm -rf "$tmp"
  fi
  run git -C "$module" fetch --quiet origin || die "fetching $repo failed"
  default=$(git -C "$module" symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo origin/main)
  default=${default#origin/}
  if $DRY_RUN; then
    echo "${C_BLD}+ move the pins of $repo on origin/$default, in a temporary worktree of $module${C_OFF}"
    return 0
  fi
  # The temporary worktree lives in the scratch dir that the exit trap
  # removes; a run that fails before removing it leaves a registration that
  # the next prune drops.
  ext_tmpdir >/dev/null
  tmp=$EXTTMP/pins-$repo
  run git -C "$module" worktree prune
  run git -C "$module" worktree add --quiet --detach "$tmp" "origin/$default" \
    || die "adding a temporary worktree of $repo failed"
  # The pin commit is made on the remote default branch's tip, then
  # published as a pin move. The actions run in a subshell of converge, or
  # end the run of step, so the temporary checkout stays out of the state
  # of the run.
  DIR[$repo]=$tmp BRANCH[$repo]=$default DIRTY[$repo]="" AHEAD[$repo]=0 BEHIND[$repo]=0
  unset "ABSENT[$repo]"
  # A partial advance reports what it held and fails; what did advance
  # is published all the same.
  ( do_update_pins "$repo" ) || status=$?
  if [ "$(git -C "$tmp" rev-parse HEAD)" != "$(git -C "$tmp" rev-parse "origin/$default")" ]; then
    publish_pins "$repo" "$default" scratch
  fi
  git -C "$module" worktree remove --force "$tmp" || true
  return $status
}

publish_pins() { # put repo $1's pin commits on its default branch $2: an immediate pull request on GitHub outside CI, a push otherwise; $3 = scratch for a temporary checkout
  local repo=$1 default=$2 dir=${DIR[$1]}
  if [ -n "${SLUG[$repo]:-}" ] && [ "${GITHUB_ACTIONS:-}" != true ]; then
    push_via_pr "$repo" "$default" "${3:-}"
  else
    run git -C "$dir" push --quiet origin "HEAD:refs/heads/$default" || die "pushing the pins of $repo to $default failed"
    echo "${C_GRN}pushed the pin updates of $repo to $default${C_OFF}"
  fi
}

run_action() {
  local action=$1 repo=$2
  case $action in
    update-pins)
      if $PIN_FROM_DEFAULT; then do_pin_on_default "$repo"; else do_update_pins "$repo"; fi ;;
    pin-on-default) do_pin_on_default "$repo" ;;
    push) do_push "$repo" ;;
    bump-submodules) do_bump_submodules ;;
    # converge advances from the remote heads, so the clone starts there
    checkout) do_checkout "$repo" heads ;;
    *) die "unknown action '$action'" ;;
  esac
}

# --------------------------------------------------------------- commands

pin_summary() { # one-line pin status for a repo
  local repo=$1 parts=() input target rev fd label
  while IFS=$'\t' read -r input target rev fd; do
    [ -n "$input" ] || continue
    label=$(pin_label "$input" "$fd")
    if [ "$rev" = "${HEADREV[$target]}" ]; then
      parts+=("${C_GRN}$label=ok${C_OFF}")
    else
      parts+=("${C_YLW}$label=stale${C_OFF}")
    fi
  done <<<"${PINS[$repo]:-}"
  if $WITH_EXTERNAL; then
    while IFS=$'\t' read -r input rev fd; do
      [ -n "$input" ] || continue
      label="ext:$(pin_label "$input" "$fd")"
      if [ "${EXTSTALE["$repo	$input	$fd"]:-ok}" = stale ]; then
        parts+=("${C_YLW}$label=stale${C_OFF}")
      else
        parts+=("${C_GRN}$label=ok${C_OFF}")
      fi
    done <<<"${EXTPINS[$repo]:-}"
  fi
  [ ${#parts[@]} -gt 0 ] && (IFS=' '; echo "${parts[*]}") || echo "-"
}

pad() { # print $2 left-justified to visible width $1 (ignoring ANSI codes)
  local plain
  plain=$(sed -E $'s/\033\\[[0-9;]*m//g' <<<"$2")
  printf '%s%*s' "$2" $(($1 > ${#plain} ? $1 - ${#plain} : 1)) ""
}

cmd_status() {
  local repo git pins
  printf "${C_BLD}%-22s %-22s %-24s %s${C_OFF}\n" REPO BRANCH GIT "LOCAL PINS"
  for repo in "${TOPO[@]}"; do
    git=""
    [ -z "${ABSENT[$repo]:-}" ] || git="${C_YLW}not checked out${C_OFF} "
    [ -n "${DIRTY[$repo]}" ] && git+="${C_RED}dirty${C_OFF} "
    [ "${LOCK_DIRTY[$repo]}" = yes ] && git+="${C_YLW}lock-dirty${C_OFF} "
    if [ "${AHEAD[$repo]}" -gt 0 ]; then git+="${C_YLW}ahead ${AHEAD[$repo]}${C_OFF} "; fi
    if [ "${BEHIND[$repo]}" -gt 0 ]; then git+="${C_RED}behind ${BEHIND[$repo]}${C_OFF} "; fi
    [ -n "$git" ] || git="${C_GRN}clean+pushed${C_OFF}"
    pins=$(pin_summary "$repo")
    if [ "$repo" = "$WS" ] && [ -n "${STALE_PTR[$WS]}" ]; then
      pins+=" ${C_YLW}[stale pointers: $(cut -f1 <<<"${STALE_PTR[$WS]}" | sed '/^$/d' | paste -sd, -)]${C_OFF}"
    fi
    printf "%-22s %-22s " "$repo" "${BRANCH[$repo]}"
    pad 24 "${git% }"
    echo " $pins"
  done

  build_plan
  echo
  local entry state action target detail work=0 notes=()
  for entry in "${PLAN[@]}"; do
    IFS='|' read -r state _ _ _ <<<"$entry"
    [ "$state" = WARN ] || work=$((work + 1))
  done
  if [ "$work" -eq 0 ]; then
    if $LOCAL; then
      echo "${C_GRN}Locally converged: working-tree pins are at the pushed sibling tips.${C_OFF}"
    else
      echo "${C_GRN}Converged: everything is committed, pushed, and pinned.${C_OFF}"
    fi
  else
    echo "${C_BLD}Pending:${C_OFF}"
  fi
  for entry in "${PLAN[@]}"; do
    IFS='|' read -r state action target detail <<<"$entry"
    case $state in
      READY) echo "  ${C_GRN}ready${C_OFF}    $action $target: $detail" ;;
      WARN) notes+=("  ${C_YLW}note${C_OFF}     $action $target: $detail") ;;
      *) echo "  ${C_RED}blocked${C_OFF}  $action $target: $detail" ;;
    esac
  done
  local n
  for n in ${notes[@]+"${notes[@]}"}; do echo "$n"; done
}

declare -A SKIP=() # "action|repo" entries converge gave up on this run

first_ready() { # optionally filtered by repo ($1)
  local entry state action target detail
  for entry in "${PLAN[@]}"; do
    IFS='|' read -r state action target detail <<<"$entry"
    [ "$state" = READY ] || continue
    [ -z "${1:-}" ] || [ "$target" = "$1" ] || continue
    [ -z "${SKIP["$action|$target"]:-}" ] || continue
    echo "$action|$target|$detail"
    return 0
  done
  return 1
}

cmd_next() {
  build_plan
  local next entry state action target detail work=0
  for entry in ${PLAN[@]+"${PLAN[@]}"}; do
    IFS='|' read -r state _ _ _ <<<"$entry"
    [ "$state" = WARN ] || work=$((work + 1))
  done
  if next=$(first_ready); then
    IFS='|' read -r action target detail <<<"$next"
    echo "next: $action $target: $detail"
  elif [ "$work" -eq 0 ]; then
    echo "${C_GRN}Converged: nothing to do.${C_OFF}"
  else
    echo "No ready actions; blocked:"
    for entry in "${PLAN[@]}"; do
      IFS='|' read -r state action target detail <<<"$entry"
      [ "$state" = WARN ] && continue
      echo "  $action $target: $detail"
    done
    return 1
  fi
}

cmd_step() {
  build_plan
  local action="" target=""
  case $# in
    0) ;;
    1)
      if [ "$1" = bump-submodules ]; then action=$1 target=$WS
      elif [ -n "${DIR[$1]:-}${ABSENT[$1]:-}" ]; then target=$1
      else die "'$1' is neither a repo nor 'bump-submodules'"
      fi ;;
    2) action=$1 target=$2; [ -n "${DIR[$target]:-}${ABSENT[$target]:-}" ] || die "unknown repo '$target'" ;;
    *) usage >&2; exit 2 ;;
  esac
  if [ -n "$action" ]; then
    run_action "$action" "$target"
    return
  fi
  # Auto mode: run the first ready action, but a failure must not wedge the
  # caller (e.g. a CI loop invoking `step` per iteration): skip it and try
  # the remaining ready actions until one succeeds. Exit 0 iff a state
  # change was made.
  local next tgt failed=() attempts=0 repo
  while next=$(first_ready "$target"); do
    IFS='|' read -r action tgt _ <<<"$next"
    if (run_action "$action" "$tgt"); then
      return 0
    fi
    SKIP["$action|$tgt"]=1
    failed+=("$action $tgt")
    echo "${C_YLW}$action $tgt failed; trying the next ready action${C_OFF}"
    attempts=$((attempts + 1))
    [ $attempts -lt 100 ] || die "too many failed attempts; giving up"
    # a failed action may still have changed state (e.g. a partial pin
    # advance), so re-read before replanning
    refresh_state
    build_plan
  done
  if [ ${#failed[@]} -gt 0 ]; then
    echo "no ready action succeeded; failed: $(IFS=,; echo "${failed[*]}")"
    return 1
  fi
  cmd_next "$@" || true
  return 1
}

cmd_converge() {
  local steps=0 attempts=0 failed=()
  while :; do
    build_plan
    local next
    if ! next=$(first_ready); then break; fi
    IFS='|' read -r action target detail <<<"$next"
    echo "${C_BLD}[step $((attempts + 1))] $action $target${C_OFF}: $detail"
    # Subshell so a failing action (e.g. a push rejected because the remote
    # moved) reports and is skipped instead of killing the whole run.
    if (run_action "$action" "$target"); then
      steps=$((steps + 1))
    else
      SKIP["$action|$target"]=1
      failed+=("$action $target")
      echo "${C_YLW}$action $target failed; continuing with the remaining work${C_OFF}"
    fi
    attempts=$((attempts + 1))
    $DRY_RUN && { echo "(dry run: stopping after first step; state would change)"; return 0; }
    [ $attempts -lt 100 ] || die "too many steps; giving up"
    # refresh state that actions changed
    refresh_state
  done
  echo
  local entry state action target detail work=0 notes=()
  for entry in ${PLAN[@]+"${PLAN[@]}"}; do
    IFS='|' read -r state action target detail <<<"$entry"
    if [ "$state" = WARN ]; then
      notes+=("  note: $action $target: $detail")
    else
      work=$((work + 1))
    fi
  done
  if [ "$work" -eq 0 ] && [ ${#failed[@]} -eq 0 ]; then
    if $LOCAL; then
      echo "${C_GRN}Locally converged after $steps step(s): working-tree locks are at the pushed sibling tips; nothing committed or pushed.${C_OFF}"
    else
      echo "${C_GRN}Converged after $steps step(s).${C_OFF}"
    fi
    local n
    for n in ${notes[@]+"${notes[@]}"}; do echo "${C_YLW}$n${C_OFF}"; done
  else
    echo "${C_YLW}Stopped after $steps step(s); remaining blockers:${C_OFF}"
    for entry in "${PLAN[@]}"; do
      IFS='|' read -r state action target detail <<<"$entry"
      [ "$state" = WARN ] && continue
      echo "  $action $target: $detail"
    done
    local f n
    for f in ${failed[@]+"${failed[@]}"}; do
      echo "  $f: failed this run (see message above)"
    done
    for n in ${notes[@]+"${notes[@]}"}; do echo "${C_YLW}$n${C_OFF}"; done
    return 1
  fi
}

pull_sub() { # down-sync one submodule ($1 = path rel to $ROOT) to the pointer recorded in tree-ish $2 (or, with --heads, to origin's default tip)
  local path=$1 ptr_ref=$2 name dir target
  name=$(basename "$path") dir=$ROOT/$path
  [ -e "$dir/.git" ] || { PULL_HELD+=("$name: not initialized"); return 0; }
  target=$(git -C "$ROOT" ls-tree "$ptr_ref" -- "$path" | awk '{print $3}')
  [ -n "$target" ] || return 0 # in .gitmodules but not in the tree
  local default
  default=$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo origin/main)
  default=${default#origin/}
  # what the branch is measured against in the messages below
  local pointer=$target goal="the recorded pointer"
  if $HEADS; then
    # load_state fetched every initialized submodule and a fresh init
    # clones current, so origin/<default> is the remote's tip as of now.
    target=$(git -C "$dir" rev-parse --quiet --verify "refs/remotes/origin/$default" || true)
    [ -n "$target" ] || { PULL_HELD+=("$name: no origin/$default to sync to"); return 0; }
    goal="origin/$default"
  fi
  local cur
  cur=$(git -C "$dir" symbolic-ref --quiet --short HEAD || echo "(detached)")
  if [ "$cur" != "(detached)" ] && [ "$cur" != "$default" ]; then
    PULL_HELD+=("$name: parked on branch $cur; not touching it")
    return 0
  fi
  if ! git -C "$dir" cat-file -e "$target^{commit}" 2>/dev/null; then
    run git -C "$dir" fetch --quiet || true
    if ! $DRY_RUN && ! git -C "$dir" cat-file -e "$target^{commit}" 2>/dev/null; then
      PULL_HELD+=("$name: recorded pointer ${target:0:12} not found even after fetch")
      return 0
    fi
  fi
  local head base=""
  head=$(git -C "$dir" rev-parse HEAD)
  git -C "$dir" show-ref --verify --quiet "refs/heads/$default" \
    && base=$(git -C "$dir" rev-parse "refs/heads/$default")
  # Attaching and fast-forwarding move working-tree files unless everything
  # already sits at the pointer, so tracked dirt only survives the no-move
  # case (untracked files never block).
  local dirty=0 line
  while IFS= read -r line; do
    case ${line:0:2} in '??') continue ;; *) dirty=$((dirty + 1)) ;; esac
  done < <(git -C "$dir" status --porcelain)
  if [ "$dirty" -gt 0 ] && { [ "$head" != "$target" ] || { [ -n "$base" ] && [ "$base" != "$target" ]; }; }; then
    PULL_HELD+=("$name: $dirty uncommitted change(s) and syncing would move files; commit or stash first")
    return 0
  fi
  if [ -z "$base" ]; then
    # no local default branch yet (fresh init): create it at the pointer
    if ! run git -C "$dir" checkout --quiet -b "$default" "$target"; then
      PULL_HELD+=("$name: creating branch $default at ${target:0:12} failed")
      return 0
    fi
    if git -C "$dir" rev-parse --quiet --verify "refs/remotes/origin/$default" >/dev/null; then
      run git -C "$dir" branch --quiet --set-upstream-to "origin/$default" "$default" || true
    fi
    PULL_SYNCED=$((PULL_SYNCED + 1))
  elif ! git -C "$dir" merge-base --is-ancestor "$base" "$target"; then
    if git -C "$dir" merge-base --is-ancestor "$target" "$base"; then
      # local default is ahead of the pointer (unpushed work, or a pull
      # mid-convergence): attach to it and leave the extra commits alone
      if [ "$cur" = "(detached)" ] && ! run git -C "$dir" checkout --quiet "$default"; then
        PULL_HELD+=("$name: checkout $default failed")
        return 0
      fi
      PULL_NOTES+=("$name: $default is ahead of $goal; left at $default")
    else
      PULL_HELD+=("$name: $default and $goal have diverged; rebase/resolve by hand")
    fi
  else
    if [ "$cur" = "(detached)" ] && ! run git -C "$dir" checkout --quiet "$default"; then
      PULL_HELD+=("$name: checkout $default failed")
      return 0
    fi
    if [ "$base" != "$target" ]; then
      if ! run git -C "$dir" merge --ff-only --quiet "$target"; then
        PULL_HELD+=("$name: fast-forward of $default to ${target:0:12} failed")
        return 0
      fi
    fi
    PULL_SYNCED=$((PULL_SYNCED + 1))
  fi
  # The invariant pull relies on: a recorded pointer is a pushed default-tip
  # once CI convergence finishes. A mismatch means convergence is mid-flight
  # (or this checkout's pointer is ahead): worth a note, not a hold. With
  # --heads the mismatch is the point: the checkout is ahead of the pointers
  # on purpose, and convergence records them when it lands.
  if $HEADS; then
    [ "$target" = "$pointer" ] \
      || PULL_NOTES+=("$name: origin/$default is past the recorded pointer; convergence records it when it lands")
    return 0
  fi
  local remote
  remote=$(git -C "$dir" rev-parse --quiet --verify "refs/remotes/origin/$default" || true)
  if [ -n "$remote" ] && [ "$remote" != "$target" ]; then
    PULL_NOTES+=("$name: recorded pointer differs from origin/$default; CI convergence may be mid-flight: rerun pull later, or pull --heads to sync to the remotes now")
  fi
  return 0
}

cmd_pull() {
  # Down-sync counterpart to converge: bring this checkout to the published
  # state instead of publishing local state. Generic git must detach
  # submodule HEADs (a gitlink is only a pin), but this workspace guarantees
  # more: after CI convergence, every recorded pointer is the pushed tip of
  # its submodule's default branch, so re-attaching each submodule to that
  # branch fast-forwarded to the pointer is well-defined. Everything moves
  # by fast-forward only; whatever can't (dirty, diverged, parked on a
  # topic branch) is held and reported, never touched.
  [ $# -eq 0 ] || { usage >&2; exit 2; }
  ! $LOCAL || die "pull moves branch refs; it has no --local mode"
  [ "${BRANCH[$WS]}" != "(detached)" ] || die "workspace is on a detached HEAD; check out a branch first"
  [ "${HAS_UPSTREAM[$WS]}" = yes ] || die "workspace branch ${BRANCH[$WS]} has no upstream to pull from"
  [ -z "${DIRTY[$WS]}" ] || die "workspace has ${DIRTY[$WS]}; commit or stash first"
  local ptr_ref=HEAD
  if [ "${BEHIND[$WS]}" -gt 0 ]; then
    run git -C "$ROOT" merge --ff-only --quiet '@{u}' \
      || die "cannot fast-forward the workspace past its upstream: it has diverged (run git pull --rebase from the workspace root) or dirty files conflict"
    # dry run: the merge didn't happen, so read pointers from where it
    # would have landed
    $DRY_RUN && ptr_ref='@{u}'
    echo "${C_GRN}workspace fast-forwarded to the tip of ${BRANCH[$WS]}'s upstream${C_OFF}"
  else
    echo "workspace already current with its upstream"
  fi
  if [ "${AHEAD[$WS]}" -gt 0 ]; then
    echo "${C_YLW}note: workspace has ${AHEAD[$WS]} unpushed commit(s); recorded pointers may be ahead of the remotes${C_OFF}"
  fi
  # A checkout may hold only some submodules. One registered in the
  # workspace's .git/config (`git submodule init`) but not cloned is
  # wanted and gets cloned; an unregistered one stays out.
  local key path missing=() PULL_ABSENT=()
  while read -r key path; do
    [ ! -e "$ROOT/$path/.git" ] || continue
    if git -C "$ROOT" config --get "${key%.path}.url" >/dev/null; then
      missing+=("$path")
    else
      PULL_ABSENT+=("$path")
    fi
  done < <(git config -f "$ROOT/.gitmodules" --get-regexp '^submodule\..*\.path$')
  if [ ${#missing[@]} -gt 0 ]; then
    run git -C "$ROOT" submodule update --init -- "${missing[@]}" \
      || echo "${C_YLW}warning: submodule init failed; the failed one(s) will be held${C_OFF}"
  fi
  local PULL_SYNCED=0 PULL_HELD=() PULL_NOTES=() # written by pull_sub (dynamic scoping)
  local absent
  while read -r key path; do
    for absent in ${PULL_ABSENT[@]+"${PULL_ABSENT[@]}"}; do
      [ "$absent" != "$path" ] || continue 2
    done
    pull_sub "$path" "$ptr_ref"
  done < <(git config -f "$ROOT/.gitmodules" --get-regexp '^submodule\..*\.path$')
  echo
  if [ ${#PULL_ABSENT[@]} -gt 0 ]; then
    echo "not checked out here, left alone: ${PULL_ABSENT[*]} (flake-sync checkout <repo> adds one)"
  fi
  local n
  for n in ${PULL_NOTES[@]+"${PULL_NOTES[@]}"}; do echo "${C_YLW}note: $n${C_OFF}"; done
  local at="the recorded pointer"
  $HEADS && at="origin's tip"
  if [ ${#PULL_HELD[@]} -eq 0 ]; then
    echo "${C_GRN}Pulled: workspace current; $PULL_SYNCED submodule(s) on their default branch at $at.${C_OFF}"
  else
    echo "${C_YLW}Pulled what was safe ($PULL_SYNCED submodule(s)); held:${C_OFF}"
    local h
    for h in "${PULL_HELD[@]}"; do echo "  $h"; done
    return 1
  fi
}

cmd_check() {
  # Run every repo's `nix flake check` against its *current* locks: the same
  # gate update-pins applies to proposed pin states, but with no overrides
  # and nothing written: a read-only "does the whole system still check"
  # sweep. Failures don't stop the sweep; the summary names them and the
  # exit status reports whether everything passed.
  local target=""
  case $# in
    0) ;;
    1) target=$1
       [ -z "${ABSENT[$target]:-}" ] || die "$target is not checked out here (flake-sync checkout $target adds it)"
       [ -n "${DIR[$target]:-}" ] || die "unknown repo '$1'" ;;
    *) usage >&2; exit 2 ;;
  esac
  [ "$CHECK_MODE" != none ] || die "check with --check=none would check nothing (use eval or full)"
  local check_flags=(--no-write-lock-file)
  [ "$CHECK_MODE" = eval ] && check_flags+=(--no-build)
  local repo dir sub fd flakedir label passed=0 failed=() absent=()
  for repo in "${TOPO[@]}"; do
    [ -z "$target" ] || [ "$repo" = "$target" ] || continue
    if [ -n "${ABSENT[$repo]:-}" ]; then absent+=("$repo"); continue; fi
    dir=${DIR[$repo]}
    local fds=(".")
    if $WITH_PARTITIONS; then
      while IFS= read -r sub; do
        fd=$(dirname "$sub")
        [ -f "$dir/$fd/flake.nix" ] && fds+=("$fd")
      done < <(git -C "$dir" ls-files -- '*/flake.lock')
    fi
    for fd in "${fds[@]}"; do
      flakedir=$dir label=$repo
      if [ "$fd" != "." ]; then flakedir=$dir/$fd label=$repo:$fd; fi
      if run nix flake check "$flakedir" "${check_flags[@]}"; then
        $DRY_RUN || echo "${C_GRN}check passed: $label${C_OFF}"
        passed=$((passed + 1))
      else
        echo "${C_RED}check FAILED: $label${C_OFF}"
        failed+=("$label")
      fi
    done
  done
  [ $((passed + ${#failed[@]})) -gt 0 ] || die "no flakes to check"
  $DRY_RUN && return 0
  echo
  [ ${#absent[@]} -eq 0 ] || echo "not checked out here, so not checked: ${absent[*]}"
  if [ ${#failed[@]} -eq 0 ]; then
    echo "${C_GRN}All checks passed: $passed flake(s), --check=$CHECK_MODE.${C_OFF}"
  else
    echo "${C_RED}${#failed[@]} of $((passed + ${#failed[@]})) flake check(s) failed: $(IFS=,; echo "${failed[*]}")${C_OFF}"
    return 1
  fi
}

cmd_override_inputs() { # print flake ref $1 and the --override-input flags that move its workspace inputs to their remotes' heads
  [ "$#" -eq 1 ] || die "usage: flake-sync override-inputs <flake-ref>"
  local ref=$1 flake attr="" key path url slug
  flake=${ref%%#*}
  [ "$flake" = "$ref" ] || attr="#${ref#*#}"
  # Workspace repos come from .gitmodules, so an uninitialized submodule
  # counts too: owner/repo for a GitHub remote, else the normalized URL.
  # With --local, an initialized submodule of this checkout stands in for
  # its remote.
  declare -A remote=() checkout=()
  local k
  while read -r key path; do
    url=$(git config -f "$ROOT/.gitmodules" "${key%.path}.url")
    slug=$(gh_slug "$url")
    if [ -n "$slug" ]; then k=gh:$slug; else k=git:$(norm_url "$url"); fi
    remote[$k]=$url
    if $LOCAL && [ -e "$ROOT/$path/.git" ]; then checkout[$k]=$ROOT/$path; fi
  done < <(git config -f "$ROOT/.gitmodules" --get-regexp '^submodule\..*\.path$')

  local meta
  meta=$(nix flake metadata --json --refresh "$flake") || die "cannot read the lock of $flake"
  # The output is split into words by the shell, so a reference with a
  # space is printed as the URL nix resolved it to, which encodes it.
  local out=()
  case $flake in
    *" "*) out+=("$(jq -r .resolvedUrl <<<"$meta")$attr") ;;
    *) out+=("$ref") ;;
  esac
  # Every github or git input reached from the root along non-follows
  # edges: "input/path<TAB>gh|git<TAB>owner/repo|url<TAB>locked-rev".
  local nodes
  nodes=$(jq -r '
    .locks as $L
    | def inputs_of($node; $prefix):
        ($L.nodes[$node].inputs // {}) | to_entries[]
        | select(.value | type == "string")
        | ($prefix + [.key]) as $p
        | ($L.nodes[.value].locked // {}) as $l
        | (if $l.type == "github" then "\($p | join("/"))\tgh\t\($l.owner)/\($l.repo)\t\($l.rev)"
           elif $l.type == "git" then "\($p | join("/"))\tgit\t\($l.url)\t\($l.rev)"
           else empty end),
          inputs_of(.value; $p);
      inputs_of($L.root; [])' <<<"$meta")

  declare -A tip=()
  local input kind id rev target dir
  while IFS=$'\t' read -r input kind id rev; do
    [ -n "$input" ] || continue
    case $kind in
      gh) k=gh:$id ;;
      git) k=git:$(norm_url "$id") ;;
    esac
    [ -n "${remote[$k]:-}" ] || continue
    dir=${checkout[$k]:-}
    if [ -z "${tip[$k]:-}" ]; then
      if [ -n "$dir" ]; then
        tip[$k]=$(git -C "$dir" rev-parse HEAD) || die "cannot read the HEAD of $dir"
        # Stderr, so a substitution carries only the arguments.
        [ -z "$(git -C "$dir" status --porcelain)" ] \
          || echo "${C_YLW}warning: $dir has uncommitted changes; pinning its HEAD without them${C_OFF}" >&2
      else
        tip[$k]=$(git ls-remote "${remote[$k]}" HEAD | cut -f1) || die "cannot read the head of ${remote[$k]}"
        [ -n "${tip[$k]}" ] || die "${remote[$k]} has no HEAD"
      fi
    fi
    [ "${tip[$k]}" != "$rev" ] || continue
    if [ -n "$dir" ]; then
      target="git+file://${dir// /%20}?rev=${tip[$k]}"
    else
      case $kind in
        gh) target="github:$id/${tip[$k]}" ;;
        git) target="git+${id// /%20}?rev=${tip[$k]}" ;;
      esac
    fi
    out+=(--override-input "$input" "$target")
  done <<<"$nodes"
  printf '%s\n' "${out[*]}"
}

cmd_checkout() { # clone the named absent submodules, or with --all every one
  local repo targets=()
  if $CHECKOUT_ALL; then
    [ $# -eq 0 ] || die "checkout takes repo names or --all, not both"
    for repo in ${ABSENT[@]+"${!ABSENT[@]}"}; do targets+=("$repo"); done
    [ ${#targets[@]} -gt 0 ] || { echo "every submodule is checked out here"; return 0; }
  else
    [ $# -gt 0 ] || die "checkout needs repo names, or --all for every submodule not checked out here"
    for repo in "$@"; do
      if [ -n "${ABSENT[$repo]:-}" ]; then targets+=("$repo")
      elif [ -n "${DIR[$repo]:-}" ]; then echo "$repo is already checked out"
      else die "unknown repo '$repo'"
      fi
    done
  fi
  local failed=()
  for repo in $(printf '%s\n' ${targets[@]+"${targets[@]}"} | sort); do
    ( do_checkout "$repo" "$($HEADS && echo heads)" ) || failed+=("$repo")
  done
  [ ${#failed[@]} -eq 0 ] || die "checkout failed for: ${failed[*]}"
}

default_ref() { # origin/<default branch> of checked-out repo $1
  local ref
  ref=$(git -C "${DIR[$1]}" symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo origin/main)
  echo "$ref"
}

remote_head() { # the remote default-branch head of repo $1
  if [ -n "${ABSENT[$1]:-}" ]; then echo "${HEADREV[$1]}"; else git -C "${DIR[$1]}" rev-parse --quiet --verify "$(default_ref "$1")" || true; fi
}

cmd_unmerged_commits() { # repos whose branch holds commits besides pin updates that are not on the remote default branch, in DAG order
  local json=false
  case "${1:-}" in --json) json=true; shift ;; esac
  [ $# -eq 0 ] || die "unmerged-commits takes no arguments besides --json"
  local repo dir base listed=() commits
  local -A COMMITS=()
  for repo in "${TOPO[@]}"; do
    [ -n "${DIR[$repo]:-}" ] || continue
    dir=${DIR[$repo]}
    base=$(default_ref "$repo")
    git -C "$dir" rev-parse --quiet --verify "$base" >/dev/null || continue
    commits=$(git -C "$dir" log --reverse --format='%h %s' "$base..HEAD" \
      | grep -v -e '^[0-9a-f]* maint: update flake pins (' -e '^[0-9a-f]* maint: bump ' || true)
    [ -n "$commits" ] || continue
    COMMITS[$repo]=$commits
    listed+=("$repo")
  done
  local lines=() dep listed_deps state pushed pr input target rev fd lock
  for repo in ${listed[@]+"${listed[@]}"}; do
    dir=${DIR[$repo]}
    base=$(default_ref "$repo")
    listed_deps=()
    for dep in ${DEPS[$repo]:-}; do
      [ -n "${COMMITS[$dep]:-}" ] && listed_deps+=("$dep")
    done
    if [ ${#listed_deps[@]} -gt 0 ]; then
      state="dependencies not ready"
    else
      # Converged when the default branch pins every workspace dependency
      # at that dependency's remote default head.
      state=ready
      lock=$(mktemp)
      if git -C "$dir" show "$base:flake.lock" >"$lock" 2>/dev/null; then
        local saved_pins=${PINS[$repo]:-} saved_deps=${DEPS[$repo]:-} saved_ext=${EXTPINS[$repo]:-}
        PINS[$repo]='' DEPS[$repo]=''
        read_lock_pins "$repo" "$lock" "."
        while IFS=$'\t' read -r input target rev fd; do
          [ -n "$input" ] || continue
          [ "$rev" = "$(remote_head "$target")" ] || { state="waiting for convergence"; break; }
        done <<<"${PINS[$repo]}"
        PINS[$repo]=$saved_pins DEPS[$repo]=$saved_deps EXTPINS[$repo]=$saved_ext
      fi
      rm -f "$lock"
    fi
    if [ "${AHEAD[$repo]}" -eq 0 ]; then pushed=yes; else pushed=no; fi
    pr=""
    if [ -n "${SLUG[$repo]:-}" ] && [ "${BRANCH[$repo]}" != "(detached)" ]; then
      pr=$("$GH" pr list -R "${SLUG[$repo]}" --head "${BRANCH[$repo]}" --state all \
        --json number,state,isDraft,url --jq 'first // empty | "\(.url) \(if .isDraft then "DRAFT" else .state end)"' 2>/dev/null || true)
    fi
    if $json; then
      lines+=("$(jq -n --arg repo "$repo" --arg branch "${BRANCH[$repo]}" --arg pushed "$pushed" \
        --arg state "$state" --arg pr "$pr" --arg commits "${COMMITS[$repo]}" \
        --args '{repo: $repo, branch: $branch, pushed: ($pushed == "yes"), state: $state,
                 dependsOn: $ARGS.positional, pullRequest: (if $pr == "" then null else $pr end),
                 commits: ($commits | split("\n"))}' ${listed_deps[@]+"${listed_deps[@]}"})")
    else
      echo "${C_BLD}$repo${C_OFF} ($state) on ${BRANCH[$repo]}, $([ "$pushed" = yes ] && echo pushed || echo "not pushed")${listed_deps[0]+, depends on ${listed_deps[*]}}${pr:+, pull request $pr}"
      while IFS= read -r commits; do echo "  $commits"; done <<<"${COMMITS[$repo]}"
    fi
  done
  if $json; then
    printf '%s\n' ${lines[@]+"${lines[@]}"} | jq -s .
  elif [ ${#listed[@]} -eq 0 ]; then
    echo "no unmerged commits besides pin updates"
  fi
}

cmd_pr() { # open or update the pull request of repo $1's branch, a draft until the change can merge
  local repo="" title="" bodyfile="" arg
  for arg in "$@"; do
    case $arg in
      --title=*) title=${arg#--title=} ;;
      --body-file=*) bodyfile=${arg#--body-file=} ;;
      -*) die "pr takes <repo> --title=<title> --body-file=<file>" ;;
      *) [ -z "$repo" ] || die "pr takes one repo"; repo=$arg ;;
    esac
  done
  [ -n "$repo" ] && [ -n "$title" ] && [ -n "$bodyfile" ] || die "pr takes <repo> --title=<title> --body-file=<file>"
  [ -f "$bodyfile" ] || die "no body file $bodyfile"
  [ -n "${DIR[$repo]:-}" ] || die "$repo is not checked out here"
  local slug=${SLUG[$repo]:-} dir=${DIR[$repo]} branch=${BRANCH[$repo]} base
  [ -n "$slug" ] || die "$repo has no GitHub remote to open a pull request on"
  base=$(default_ref "$repo")
  [ "$branch" != "(detached)" ] && [ "$branch" != "${base#origin/}" ] \
    || die "$repo must be on a topic branch to open a pull request"
  local info state deps existing
  info=$(cmd_unmerged_commits --json | jq -c --arg r "$repo" '.[] | select(.repo == $r)')
  [ -n "$info" ] || die "$repo has no unmerged commits besides pin updates"
  state=$(jq -r .state <<<"$info")
  deps=$(jq -r '.dependsOn | join(", ")' <<<"$info")
  existing=$("$GH" pr list -R "$slug" --head "$branch" --state all --json number,state,isDraft,url \
    --jq 'first // empty | "\(.url) \(if .isDraft then "DRAFT" else .state end)"' 2>/dev/null || true)
  case $existing in *" MERGED") die "the pull request of $branch is merged (${existing% *}); it takes no new commits" ;; esac
  # The status line says why a pull request stays a draft.
  local status=""
  case $state in
    "dependencies not ready") status="status: dependencies not ready (waiting on $deps to merge)" ;;
    "waiting for convergence") status="status: waiting for convergence (the default branch does not pin the merged dependencies yet)" ;;
    *) git -C "$dir" merge-base --is-ancestor "$base" HEAD \
         || status="status: needs a rebase onto ${base#origin/} (flake-sync rebase $repo)" ;;
  esac
  local body
  body=$(cat "$bodyfile")
  [ -z "$status" ] || body=$(printf '%s\n\n%s\n' "$status" "$body")
  do_push "$repo"
  if [ -z "$existing" ]; then
    local draft=()
    [ -z "$status" ] || draft=(--draft)
    run "$GH" pr create -R "$slug" --base "${base#origin/}" --head "$branch" --title "$title" --body "$body" \
      --assignee @me ${draft[@]+"${draft[@]}"} || die "opening the pull request for $repo failed"
  else
    run "$GH" pr edit -R "$slug" "${existing% *}" --title "$title" --body "$body" || die "updating ${existing% *} failed"
    if [ -z "$status" ] && [ "${existing##* }" = DRAFT ]; then
      run "$GH" pr ready -R "$slug" "${existing% *}" || die "marking ${existing% *} ready failed"
    elif [ -n "$status" ] && [ "${existing##* }" = OPEN ]; then
      run "$GH" pr ready -R "$slug" "${existing% *}" --undo || die "returning ${existing% *} to draft failed"
    fi
  fi
  if [ -n "$status" ]; then echo "${C_YLW}$repo: draft pull request; $status${C_OFF}"; else echo "${C_GRN}$repo: pull request ready for review${C_OFF}"; fi
}

cmd_rebase() { # rebase repo $1's topic branch onto its remote default branch, keeping that branch's pins
  [ $# -eq 1 ] || die "rebase takes one repo"
  local repo=$1
  [ -n "${DIR[$repo]:-}" ] || die "$repo is not checked out here"
  local dir=${DIR[$repo]} base branch=${BRANCH[$repo]}
  base=$(default_ref "$repo")
  [ "$branch" != "(detached)" ] && [ "$branch" != "${base#origin/}" ] || die "$repo must be on a topic branch to rebase it"
  [ -z "${DIRTY[$repo]}" ] && [ "${LOCK_DIRTY[$repo]}" = no ] || die "$repo has uncommitted changes; commit or discard them first"
  run git -C "$dir" fetch --quiet origin || die "fetching $repo failed"
  $DRY_RUN && { echo "+ git -C $dir rebase $base, resolving flake.lock conflicts from $base"; return 0; }
  git -C "$dir" -c core.editor=true rebase --quiet --empty=drop "$base" >/dev/null 2>&1 && {
    echo "${C_GRN}rebased $repo ($branch) onto $base${C_OFF}"; return 0; }
  # Conflicts: a lock takes the default branch's version, whose pins are
  # converged, and nix flake lock adds what the branch's flake.nix adds.
  # Any other conflicted file stops the rebase for resolution by hand.
  local file other locks
  while [ -d "$(git -C "$dir" rev-parse --git-path rebase-merge)" ] || [ -d "$(git -C "$dir" rev-parse --git-path rebase-apply)" ]; do
    other=$(git -C "$dir" diff --name-only --diff-filter=U | grep -v -e '^flake\.lock$' -e '/flake\.lock$' || true)
    [ -z "$other" ] || die "rebasing $repo stopped on conflicts in: $(paste -sd' ' <<<"$other"); resolve them, git rebase --continue, then rerun"
    locks=$(git -C "$dir" diff --name-only --diff-filter=U)
    [ -n "$locks" ] || die "rebasing $repo stopped without a conflicted file; see git -C ${dir#"$ROOT"/} status"
    for file in $locks; do
      git -C "$dir" checkout --ours -- "$file"
      nix flake lock "$dir/$(dirname "$file")" >/dev/null 2>&1 || die "nix flake lock failed for $repo:$(dirname "$file") during the rebase"
      git -C "$dir" add -- "$file"
    done
    echo "resolved ${locks//$'\n'/ } in $repo from $base"
    GIT_EDITOR=true git -C "$dir" rebase --continue >/dev/null 2>&1 || true
  done
  echo "${C_GRN}rebased $repo ($branch) onto $base${C_OFF}"
}

cmd_graph() {
  local repo dep
  echo "topological order (dependencies first):"
  for repo in "${TOPO[@]}"; do
    local deps="${DEPS[$repo]:-}"
    printf "  %-22s" "$repo"
    [ -n "${deps// /}" ] && echo "<- ${deps% }" || echo "(no local deps)"
  done
}

# ------------------------------------------------------------------- main

CMD=""
ARGS=()
for arg in "$@"; do
  case $arg in
    -n | --dry-run) DRY_RUN=true ;;
    --check | --check=eval) CHECK_MODE="eval" ;;
    --check=none) CHECK_MODE=none ;;
    --check=full) CHECK_MODE=full ;;
    --check=*) die "invalid --check mode '${arg#--check=}' (use none, eval, or full)" ;;
    --fetch) DO_FETCH=true ;;
    --heads) HEADS=true ;;
    --local) LOCAL=true ;;
    --checkout-missing) CHECKOUT_MISSING=true ;;
    --trust-local-checks) TRUST_LOCAL_CHECKS=true ;;
    --json | --title=* | --body-file=*) ARGS+=("$arg") ;; # unmerged-commits, pr
    --with-partitions) WITH_PARTITIONS=true ;;
    --with-tests) WITH_TESTS=true ;;
    --with-external) WITH_EXTERNAL=true ;;
    --all) WITH_PARTITIONS=true WITH_TESTS=true WITH_EXTERNAL=true CHECKOUT_ALL=true ;;
    --latest-flake-sync) ;; # handled before anything else; reaching here means this is that copy
    -h | --help) usage; exit 0 ;;
    --version) build_id; exit 0 ;;
    -*) die "unknown option '$arg' (see --help)" ;;
    *) if [ -z "$CMD" ]; then CMD=$arg; else ARGS+=("$arg"); fi ;;
  esac
done
[ -n "$CMD" ] || { usage >&2; exit 2; }

command -v jq >/dev/null || die "jq is required"

# pull without fetching would sync to yesterday's remote state
[ "$CMD" != pull ] || DO_FETCH=true
case $CMD in pull | checkout) ;; *) ! $HEADS || die "--heads applies to pull and checkout only" ;; esac
! $TRUST_LOCAL_CHECKS || [ "$CHECK_MODE" != none ] || die "--trust-local-checks runs nix flake check here before merging; it needs --check=eval or --check=full"
[ "$CMD" != checkout ] || ! $CHECKOUT_MISSING || die "--checkout-missing applies to converge, step, next and status"

# checkout needs only the list of submodules and which are checked out.
if [ "$CMD" = checkout ]; then
  discover_repos
  cmd_checkout "${ARGS[@]}"
  exit 0
fi

# override-inputs reads only .gitmodules, the flake and the remotes, so it needs
# none of the working-tree state.
if [ "$CMD" = override-inputs ]; then
  cmd_override_inputs "${ARGS[@]}"
  exit 0
fi

# A linked worktree of the workspace holds topic branches, which carry no
# pin moves. A publishing converge or step there reads each submodule from
# its remote default branch and makes the pin moves on that branch, in a
# temporary worktree, leaving the topic branches as they are. `step push
# <repo>` pushes a topic branch, once every repo it depends on has its
# commits pushed.
LINKED=false
[ "$(git -C "$ROOT" rev-parse --path-format=absolute --git-dir)" = "$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)" ] || LINKED=true
if $LINKED && ! $LOCAL; then
  case $CMD in
    converge) PIN_FROM_DEFAULT=true DO_FETCH=true ;;
    step) [ "${ARGS[0]:-}" = push ] || PIN_FROM_DEFAULT=true DO_FETCH=true ;;
  esac
fi

load_state

case $CMD in
  status) cmd_status "${ARGS[@]}" ;;
  next) cmd_next "${ARGS[@]}" ;;
  step) cmd_step "${ARGS[@]}" ;;
  converge) cmd_converge "${ARGS[@]}" ;;
  pull) cmd_pull "${ARGS[@]}" ;;
  check) cmd_check "${ARGS[@]}" ;;
  graph) cmd_graph "${ARGS[@]}" ;;
  unmerged-commits) cmd_unmerged_commits "${ARGS[@]}" ;;
  pr) cmd_pr "${ARGS[@]}" ;;
  rebase) cmd_rebase "${ARGS[@]}" ;;
  *) die "unknown command '$CMD' (see --help)" ;;
esac
